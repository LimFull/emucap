+void ScriptingContext::CallbackRemoved(const void* collection, size_t index)
+{
+	for(CallbackIteration* cursor = _callbackIteration; cursor; cursor = cursor->Previous) {
+		if(cursor->Collection == collection) {
+			if(index < cursor->Index) cursor->Index--;
+			if(index < cursor->End) cursor->End--;
+		}
+	}
+}
