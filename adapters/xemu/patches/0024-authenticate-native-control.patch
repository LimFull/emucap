+#define EMUCAP_TEST_HEADER_SIZE 7
+#define EMUCAP_TEST_NONCE_SIZE 16
+#define EMUCAP_TEST_PROOF_SIZE 32
+#define EMUCAP_TEST_HELLO_SIZE \
+    (EMUCAP_TEST_HEADER_SIZE + EMUCAP_TEST_NONCE_SIZE)
+#define EMUCAP_TEST_SERVER_PROOF_SIZE \
+    (EMUCAP_TEST_HEADER_SIZE + EMUCAP_TEST_NONCE_SIZE + \
+     EMUCAP_TEST_PROOF_SIZE)
+#define EMUCAP_TEST_CLIENT_PROOF_SIZE \
+    (EMUCAP_TEST_HEADER_SIZE + EMUCAP_TEST_PROOF_SIZE)
+
+static const char emucap_test_token[] =
+    "native-0123456789abcdefghijklmnopqrstuvwxyz-"
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789";
+
+typedef struct EmucapAuthTestClient {
+    SocketAddress *addr;
+} EmucapAuthTestClient;
+
+static void emucap_test_auth_header(uint8_t *header, uint8_t type)
+{
+    memcpy(header, "ECXA", 4);
+    header[4] = 1;
+    header[5] = type;
+    header[6] = 1;
+}
+
+static void emucap_test_auth_proof(const char *direction,
+                                   const uint8_t *client_nonce,
+                                   const uint8_t *server_nonce,
+                                   uint8_t proof[EMUCAP_TEST_PROOF_SIZE])
+{
+    static const char domain[] = "emucap-xemu-qmp-auth-v1";
+    const uint8_t *fields[] = {
+        (const uint8_t *)domain,
+        (const uint8_t *)direction,
+        client_nonce,
+        server_nonce,
+    };
+    size_t sizes[] = {
+        strlen(domain),
+        strlen(direction),
+        EMUCAP_TEST_NONCE_SIZE,
+        EMUCAP_TEST_NONCE_SIZE,
+    };
+    uint64_t lengths[G_N_ELEMENTS(fields)];
+    struct iovec iov[G_N_ELEMENTS(fields) * 2];
+    g_autoptr(QCryptoHmac) hmac = NULL;
+    uint8_t *result = proof;
+    size_t result_size = EMUCAP_TEST_PROOF_SIZE;
+    size_t i;
+
+    hmac = qcrypto_hmac_new(QCRYPTO_HASH_ALGO_SHA256,
+                            (const uint8_t *)emucap_test_token,
+                            strlen(emucap_test_token), &error_abort);
+    for (i = 0; i < G_N_ELEMENTS(fields); i++) {
+        lengths[i] = cpu_to_be64(sizes[i]);
+        iov[i * 2].iov_base = &lengths[i];
+        iov[i * 2].iov_len = sizeof(lengths[i]);
+        iov[i * 2 + 1].iov_base = (void *)fields[i];
+        iov[i * 2 + 1].iov_len = sizes[i];
+    }
+    g_assert_cmpint(qcrypto_hmac_bytesv(hmac, iov, G_N_ELEMENTS(iov),
+                                       &result, &result_size,
+                                       &error_abort), ==, 0);
+    g_assert(result == proof);
+    g_assert_cmpuint(result_size, ==, EMUCAP_TEST_PROOF_SIZE);
+}
+
+static gpointer emucap_auth_test_client(gpointer opaque)
+{
+    EmucapAuthTestClient *client = opaque;
+    QIOChannelSocket *ioc = qio_channel_socket_new();
+    uint8_t hello[EMUCAP_TEST_HELLO_SIZE];
+    uint8_t challenge[EMUCAP_TEST_SERVER_PROOF_SIZE];
+    uint8_t expected[EMUCAP_TEST_PROOF_SIZE];
+    uint8_t response[EMUCAP_TEST_CLIENT_PROOF_SIZE + 4];
+    uint8_t acknowledgement[EMUCAP_TEST_HEADER_SIZE];
+    uint8_t expected_header[EMUCAP_TEST_HEADER_SIZE];
+    uint8_t client_nonce[EMUCAP_TEST_NONCE_SIZE];
+    const uint8_t *server_nonce = challenge + EMUCAP_TEST_HEADER_SIZE;
+
+    memset(client_nonce, 0x11, sizeof(client_nonce));
+    qio_channel_socket_connect_sync(ioc, client->addr, &error_abort);
+    emucap_test_auth_header(hello, 1);
+    memcpy(hello + EMUCAP_TEST_HEADER_SIZE,
+           client_nonce, sizeof(client_nonce));
+    g_assert_cmpint(qio_channel_write_all(QIO_CHANNEL(ioc), hello,
+                                         sizeof(hello), &error_abort), ==, 0);
+    g_assert_cmpint(qio_channel_read_all(QIO_CHANNEL(ioc), challenge,
+                                        sizeof(challenge), &error_abort), ==, 0);
+    emucap_test_auth_header(expected_header, 2);
+    g_assert_cmpmem(challenge, EMUCAP_TEST_HEADER_SIZE,
+                    expected_header, sizeof(expected_header));
+    emucap_test_auth_proof("server", client_nonce, server_nonce, expected);
+    g_assert_cmpmem(challenge + EMUCAP_TEST_HEADER_SIZE +
+                    EMUCAP_TEST_NONCE_SIZE,
+                    EMUCAP_TEST_PROOF_SIZE, expected, sizeof(expected));
+
+    emucap_test_auth_header(response, 3);
+    emucap_test_auth_proof("client", client_nonce, server_nonce,
+                           response + EMUCAP_TEST_HEADER_SIZE);
+    memcpy(response + EMUCAP_TEST_CLIENT_PROOF_SIZE, "AUTH", 4);
+    g_assert_cmpint(qio_channel_write_all(QIO_CHANNEL(ioc), response,
+                                         sizeof(response), &error_abort), ==, 0);
+    g_assert_cmpint(qio_channel_read_all(QIO_CHANNEL(ioc), acknowledgement,
+                                        sizeof(acknowledgement),
+                                        &error_abort), ==, 0);
+    emucap_test_auth_header(expected_header, 4);
+    g_assert_cmpmem(acknowledgement, sizeof(acknowledgement),
+                    expected_header, sizeof(expected_header));
+    object_unref(OBJECT(ioc));
+    return NULL;
+}
