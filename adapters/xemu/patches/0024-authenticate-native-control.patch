+    g_assert_cmpint(handler.openclose_count, ==, 1);
+    g_assert_cmpmem(handler.read_buf, handler.read_count, "AUTH", 4);
+    qemu_thread_join(&thread);
+
+    qemu_chr_fe_deinit(&frontend, false);
+    object_unparent(OBJECT(chr));
+    qapi_free_SocketAddress(addr);
+    g_unsetenv("EMUCAP_NATIVE_DEBUG_TOKEN");
+}
