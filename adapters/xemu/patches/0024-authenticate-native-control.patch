@@ -33,6 +33,9 @@
 #include "qapi/clone-visitor.h"
 #include "qapi/qapi-visit-sockets.h"
 #include "qemu/yank.h"
+#include "crypto/hmac.h"
+#include "crypto/random.h"
+#include "qemu/bswap.h"
 #include "trace.h"
 
 #include "chardev/char-io.h"
@@ -40,6 +43,597 @@
 
 static gboolean socket_reconnect_timeout(gpointer opaque);
 static void tcp_chr_telnet_init(Chardev *chr);
+static void tcp_chr_change_state(SocketChardev *s, TCPChardevState state);
+static void tcp_chr_set_listener_handler(Chardev *chr);
+static int tcp_chr_new_client(Chardev *chr, QIOChannelSocket *sioc);
+static void tcp_chr_set_client_ioc_name(Chardev *chr,
+                                        QIOChannelSocket *sioc);
+static void char_socket_yank_iochannel(void *opaque);
+static bool emucap_socket_auth_init(SocketChardev *s,
+                                    ChardevSocket *sock,
+                                    Error **errp);
+static void emucap_socket_auth_cleanup(SocketChardev *s);
+
+#define EMUCAP_AUTH_MAX_CANDIDATES 8
+#define EMUCAP_AUTH_ACCEPTS_PER_TURN 2
+#define EMUCAP_AUTH_TIMEOUT_MS 5000
+#define EMUCAP_AUTH_MAGIC "ECXA"
+#define EMUCAP_AUTH_HEADER_SIZE 7
+#define EMUCAP_AUTH_NONCE_SIZE 16
+#define EMUCAP_AUTH_PROOF_SIZE 32
+#define EMUCAP_AUTH_TOKEN_MAX 256
+#define EMUCAP_AUTH_CLIENT_HELLO_SIZE \
+    (EMUCAP_AUTH_HEADER_SIZE + EMUCAP_AUTH_NONCE_SIZE)
+#define EMUCAP_AUTH_SERVER_PROOF_SIZE \
+    (EMUCAP_AUTH_HEADER_SIZE + EMUCAP_AUTH_NONCE_SIZE + \
+     EMUCAP_AUTH_PROOF_SIZE)
+#define EMUCAP_AUTH_CLIENT_PROOF_SIZE \
+    (EMUCAP_AUTH_HEADER_SIZE + EMUCAP_AUTH_PROOF_SIZE)
+#define EMUCAP_AUTH_SERVER_OK_SIZE EMUCAP_AUTH_HEADER_SIZE
+
+typedef enum EmucapAuthPhase {
+    EMUCAP_AUTH_AWAIT_HELLO,
+    EMUCAP_AUTH_WRITE_SERVER_PROOF,
+    EMUCAP_AUTH_AWAIT_CLIENT_PROOF,
+    EMUCAP_AUTH_WRITE_SERVER_OK,
+} EmucapAuthPhase;
+
+typedef struct EmucapAuthCandidate EmucapAuthCandidate;
+
+struct EmucapSocketAuth {
+    SocketChardev *socket;
+    char *token;
+    const char *domain;
+    uint8_t endpoint;
+    GPtrArray *candidates;
+    uint64_t next_serial;
+    unsigned int accepts_this_turn;
+    GSource *accept_resume_source;
+};
+
+struct EmucapAuthCandidate {
+    EmucapSocketAuth *auth;
+    QIOChannelSocket *sioc;
+    GSource *io_source;
+    GSource *timeout_source;
+    int64_t deadline_us;
+    uint64_t serial;
+    EmucapAuthPhase phase;
+    bool verified;
+    uint8_t input[EMUCAP_AUTH_CLIENT_PROOF_SIZE];
+    size_t input_offset;
+    size_t input_size;
+    uint8_t output[EMUCAP_AUTH_SERVER_PROOF_SIZE];
+    size_t output_offset;
+    size_t output_size;
+    uint8_t client_nonce[EMUCAP_AUTH_NONCE_SIZE];
+    uint8_t server_nonce[EMUCAP_AUTH_NONCE_SIZE];
+};
+
+static void emucap_auth_accept(QIONetListener *listener,
+                               QIOChannelSocket *cioc,
+                               void *opaque);
+
+static void emucap_auth_header(uint8_t *header,
+                               uint8_t type,
+                               uint8_t endpoint)
+{
+    memcpy(header, EMUCAP_AUTH_MAGIC, 4);
+    header[4] = 1;
+    header[5] = type;
+    header[6] = endpoint;
+}
+
+static bool emucap_auth_header_matches(const uint8_t *header,
+                                       uint8_t type,
+                                       uint8_t endpoint)
+{
+    uint8_t expected[EMUCAP_AUTH_HEADER_SIZE];
+
+    emucap_auth_header(expected, type, endpoint);
+    return memcmp(header, expected, sizeof(expected)) == 0;
+}
+
+static bool emucap_auth_constant_time_equal(const uint8_t *left,
+                                            const uint8_t *right,
+                                            size_t size)
+{
+    uint8_t difference = 0;
+    size_t i;
+
+    for (i = 0; i < size; i++) {
+        difference |= left[i] ^ right[i];
+    }
+    return difference == 0;
+}
+
+static bool emucap_auth_proof(EmucapSocketAuth *auth,
+                              const char *direction,
+                              const uint8_t *client_nonce,
+                              const uint8_t *server_nonce,
+                              uint8_t proof[EMUCAP_AUTH_PROOF_SIZE])
+{
+    const uint8_t *fields[] = {
+        (const uint8_t *)auth->domain,
+        (const uint8_t *)direction,
+        client_nonce,
+        server_nonce,
+    };
+    size_t sizes[] = {
+        strlen(auth->domain),
+        strlen(direction),
+        EMUCAP_AUTH_NONCE_SIZE,
+        EMUCAP_AUTH_NONCE_SIZE,
+    };
+    uint64_t lengths[G_N_ELEMENTS(fields)];
+    struct iovec iov[G_N_ELEMENTS(fields) * 2];
+    g_autoptr(QCryptoHmac) hmac = NULL;
+    uint8_t *result = proof;
+    size_t result_size = EMUCAP_AUTH_PROOF_SIZE;
+    Error *error = NULL;
+    size_t i;
+
+    hmac = qcrypto_hmac_new(QCRYPTO_HASH_ALGO_SHA256,
+                            (const uint8_t *)auth->token,
+                            strlen(auth->token), &error);
+    if (!hmac) {
+        error_free(error);
+        return false;
+    }
+    for (i = 0; i < G_N_ELEMENTS(fields); i++) {
+        lengths[i] = cpu_to_be64(sizes[i]);
+        iov[i * 2].iov_base = &lengths[i];
+        iov[i * 2].iov_len = sizeof(lengths[i]);
+        iov[i * 2 + 1].iov_base = (void *)fields[i];
+        iov[i * 2 + 1].iov_len = sizes[i];
+    }
+    if (qcrypto_hmac_bytesv(hmac, iov, G_N_ELEMENTS(iov),
+                            &result, &result_size, &error) < 0) {
+        error_free(error);
+        return false;
+    }
+    return result == proof && result_size == EMUCAP_AUTH_PROOF_SIZE;
+}
+
+static void emucap_auth_clear_source(GSource **source)
+{
+    if (*source) {
+        g_source_destroy(*source);
+        g_source_unref(*source);
+        *source = NULL;
+    }
+}
+
+static void emucap_auth_candidate_destroy(EmucapAuthCandidate *candidate,
+                                          bool close_channel)
+{
+    emucap_auth_clear_source(&candidate->io_source);
+    emucap_auth_clear_source(&candidate->timeout_source);
+    if (candidate->sioc) {
+        if (close_channel) {
+            qio_channel_shutdown(QIO_CHANNEL(candidate->sioc),
+                                 QIO_CHANNEL_SHUTDOWN_BOTH, NULL);
+            qio_channel_close(QIO_CHANNEL(candidate->sioc), NULL);
+        }
+        object_unref(OBJECT(candidate->sioc));
+    }
+    g_free(candidate);
+}
+
+static void emucap_auth_remove_candidate(EmucapAuthCandidate *candidate,
+                                         bool close_channel)
+{
+    EmucapSocketAuth *auth = candidate->auth;
+    size_t i;
+
+    for (i = 0; i < auth->candidates->len; i++) {
+        if (g_ptr_array_index(auth->candidates, i) == candidate) {
+            g_ptr_array_remove_index(auth->candidates, i);
+            break;
+        }
+    }
+    emucap_auth_candidate_destroy(candidate, close_channel);
+}
+
+static gboolean emucap_auth_candidate_timeout(gpointer opaque)
+{
+    EmucapAuthCandidate *candidate = opaque;
+    GSource *source = candidate->timeout_source;
+
+    candidate->timeout_source = NULL;
+    g_source_unref(source);
+    emucap_auth_remove_candidate(candidate, true);
+    return G_SOURCE_REMOVE;
+}
+
+static void emucap_auth_arm_candidate(EmucapAuthCandidate *candidate,
+                                      GIOCondition condition);
+
+static bool emucap_auth_prepare_server_proof(EmucapAuthCandidate *candidate)
+{
+    uint8_t *proof;
+    Error *error = NULL;
+
+    if (!emucap_auth_header_matches(candidate->input, 1,
+                                    candidate->auth->endpoint)) {
+        return false;
+    }
+    memcpy(candidate->client_nonce,
+           candidate->input + EMUCAP_AUTH_HEADER_SIZE,
+           EMUCAP_AUTH_NONCE_SIZE);
+    if (qcrypto_random_bytes(candidate->server_nonce,
+                             sizeof(candidate->server_nonce), &error) < 0) {
+        error_free(error);
+        return false;
+    }
+    emucap_auth_header(candidate->output, 2, candidate->auth->endpoint);
+    memcpy(candidate->output + EMUCAP_AUTH_HEADER_SIZE,
+           candidate->server_nonce, EMUCAP_AUTH_NONCE_SIZE);
+    proof = candidate->output + EMUCAP_AUTH_HEADER_SIZE +
+            EMUCAP_AUTH_NONCE_SIZE;
+    if (!emucap_auth_proof(candidate->auth, "server",
+                           candidate->client_nonce,
+                           candidate->server_nonce, proof)) {
+        return false;
+    }
+    candidate->output_offset = 0;
+    candidate->output_size = EMUCAP_AUTH_SERVER_PROOF_SIZE;
+    candidate->phase = EMUCAP_AUTH_WRITE_SERVER_PROOF;
+    return true;
+}
+
+static bool emucap_auth_validate_client_proof(EmucapAuthCandidate *candidate)
+{
+    uint8_t expected[EMUCAP_AUTH_PROOF_SIZE];
+
+    if (!emucap_auth_header_matches(candidate->input, 3,
+                                    candidate->auth->endpoint) ||
+        !emucap_auth_proof(candidate->auth, "client",
+                           candidate->client_nonce,
+                           candidate->server_nonce, expected) ||
+        !emucap_auth_constant_time_equal(
+            expected, candidate->input + EMUCAP_AUTH_HEADER_SIZE,
+            sizeof(expected))) {
+        return false;
+    }
+    emucap_auth_header(candidate->output, 4, candidate->auth->endpoint);
+    candidate->output_offset = 0;
+    candidate->output_size = EMUCAP_AUTH_SERVER_OK_SIZE;
+    candidate->phase = EMUCAP_AUTH_WRITE_SERVER_OK;
+    candidate->verified = true;
+    return true;
+}
+
+static void emucap_auth_close_other_candidates(
+    EmucapAuthCandidate *selected)
+{
+    EmucapSocketAuth *auth = selected->auth;
+    size_t i = auth->candidates->len;
+
+    while (i > 0) {
+        EmucapAuthCandidate *candidate =
+            g_ptr_array_index(auth->candidates, --i);
+        if (candidate != selected) {
+            emucap_auth_remove_candidate(candidate, true);
+        }
+    }
+}
+
+static void emucap_auth_cancel_accept_resume(EmucapSocketAuth *auth)
+{
+    emucap_auth_clear_source(&auth->accept_resume_source);
+    auth->accepts_this_turn = 0;
+}
+
+static void emucap_auth_promote(EmucapAuthCandidate *candidate)
+{
+    EmucapSocketAuth *auth = candidate->auth;
+    SocketChardev *s = auth->socket;
+    Chardev *chr = CHARDEV(s);
+    QIOChannelSocket *sioc = candidate->sioc;
+    size_t i;
+
+    assert(candidate->verified);
+    assert(candidate->output_offset == candidate->output_size);
+    emucap_auth_close_other_candidates(candidate);
+    for (i = 0; i < auth->candidates->len; i++) {
+        if (g_ptr_array_index(auth->candidates, i) == candidate) {
+            g_ptr_array_remove_index(auth->candidates, i);
+            break;
+        }
+    }
+    emucap_auth_clear_source(&candidate->io_source);
+    emucap_auth_clear_source(&candidate->timeout_source);
+    candidate->sioc = NULL;
+    g_free(candidate);
+
+    emucap_auth_cancel_accept_resume(auth);
+    qio_net_listener_set_client_func_full(s->listener, NULL, NULL,
+                                          NULL, chr->gcontext);
+    tcp_chr_change_state(s, TCP_CHARDEV_STATE_CONNECTING);
+    tcp_chr_set_client_ioc_name(chr, sioc);
+    if (s->registered_yank) {
+        yank_register_function(CHARDEV_YANK_INSTANCE(chr->label),
+                               char_socket_yank_iochannel,
+                               QIO_CHANNEL(sioc));
+    }
+    if (tcp_chr_new_client(chr, sioc) < 0) {
+        if (s->registered_yank) {
+            yank_unregister_function(CHARDEV_YANK_INSTANCE(chr->label),
+                                     char_socket_yank_iochannel,
+                                     QIO_CHANNEL(sioc));
+        }
+        tcp_chr_change_state(s, TCP_CHARDEV_STATE_DISCONNECTED);
+        qio_channel_shutdown(QIO_CHANNEL(sioc),
+                             QIO_CHANNEL_SHUTDOWN_BOTH, NULL);
+        qio_channel_close(QIO_CHANNEL(sioc), NULL);
+        tcp_chr_set_listener_handler(chr);
+    }
+    object_unref(OBJECT(sioc));
+}
+
+static gboolean emucap_auth_candidate_io(QIOChannel *ioc,
+                                         GIOCondition condition,
+                                         gpointer opaque)
+{
+    EmucapAuthCandidate *candidate = opaque;
+    GSource *source = candidate->io_source;
+    Error *error = NULL;
+    ssize_t result;
+
+    candidate->io_source = NULL;
+    g_source_unref(source);
+    if (g_get_monotonic_time() >= candidate->deadline_us) {
+        emucap_auth_remove_candidate(candidate, true);
+        return G_SOURCE_REMOVE;
+    }
+    if (condition & (G_IO_HUP | G_IO_ERR | G_IO_NVAL)) {
+        emucap_auth_remove_candidate(candidate, true);
+        return G_SOURCE_REMOVE;
+    }
+
+    if (candidate->phase == EMUCAP_AUTH_AWAIT_HELLO ||
+        candidate->phase == EMUCAP_AUTH_AWAIT_CLIENT_PROOF) {
+        result = qio_channel_read(ioc,
+                                  candidate->input + candidate->input_offset,
+                                  candidate->input_size -
+                                  candidate->input_offset, &error);
+        if (result == QIO_CHANNEL_ERR_BLOCK) {
+            error_free(error);
+            emucap_auth_arm_candidate(candidate, G_IO_IN);
+            return G_SOURCE_REMOVE;
+        }
+        if (result <= 0) {
+            error_free(error);
+            emucap_auth_remove_candidate(candidate, true);
+            return G_SOURCE_REMOVE;
+        }
+        candidate->input_offset += result;
+        if (candidate->input_offset != candidate->input_size) {
+            emucap_auth_arm_candidate(candidate, G_IO_IN);
+            return G_SOURCE_REMOVE;
+        }
+        if ((candidate->phase == EMUCAP_AUTH_AWAIT_HELLO &&
+             !emucap_auth_prepare_server_proof(candidate)) ||
+            (candidate->phase == EMUCAP_AUTH_AWAIT_CLIENT_PROOF &&
+             !emucap_auth_validate_client_proof(candidate))) {
+            emucap_auth_remove_candidate(candidate, true);
+            return G_SOURCE_REMOVE;
+        }
+        emucap_auth_arm_candidate(candidate, G_IO_OUT);
+        return G_SOURCE_REMOVE;
+    }
+
+    result = qio_channel_write(ioc,
+                               candidate->output + candidate->output_offset,
+                               candidate->output_size -
+                               candidate->output_offset, &error);
+    if (result == QIO_CHANNEL_ERR_BLOCK) {
+        error_free(error);
+        emucap_auth_arm_candidate(candidate, G_IO_OUT);
+        return G_SOURCE_REMOVE;
+    }
+    if (result <= 0) {
+        error_free(error);
+        emucap_auth_remove_candidate(candidate, true);
+        return G_SOURCE_REMOVE;
+    }
+    candidate->output_offset += result;
+    if (candidate->output_offset != candidate->output_size) {
+        emucap_auth_arm_candidate(candidate, G_IO_OUT);
+        return G_SOURCE_REMOVE;
+    }
+    if (candidate->phase == EMUCAP_AUTH_WRITE_SERVER_OK) {
+        emucap_auth_promote(candidate);
+        return G_SOURCE_REMOVE;
+    }
+
+    candidate->phase = EMUCAP_AUTH_AWAIT_CLIENT_PROOF;
+    candidate->input_offset = 0;
+    candidate->input_size = EMUCAP_AUTH_CLIENT_PROOF_SIZE;
+    emucap_auth_arm_candidate(candidate, G_IO_IN);
+    return G_SOURCE_REMOVE;
+}
+
+static void emucap_auth_arm_candidate(EmucapAuthCandidate *candidate,
+                                      GIOCondition condition)
+{
+    Chardev *chr = CHARDEV(candidate->auth->socket);
+
+    assert(candidate->io_source == NULL);
+    candidate->io_source = qio_channel_create_watch(
+        QIO_CHANNEL(candidate->sioc),
+        condition | G_IO_HUP | G_IO_ERR | G_IO_NVAL);
+    g_source_set_priority(candidate->io_source, G_PRIORITY_DEFAULT - 10);
+    g_source_set_callback(candidate->io_source,
+                          (GSourceFunc)emucap_auth_candidate_io,
+                          candidate, NULL);
+    g_source_attach(candidate->io_source, chr->gcontext);
+}
+
+static gboolean emucap_auth_resume_accepts(gpointer opaque)
+{
+    EmucapSocketAuth *auth = opaque;
+    GSource *source = auth->accept_resume_source;
+
+    auth->accept_resume_source = NULL;
+    g_source_unref(source);
+    auth->accepts_this_turn = 0;
+    if (auth->socket->listener &&
+        auth->socket->state == TCP_CHARDEV_STATE_DISCONNECTED) {
+        tcp_chr_set_listener_handler(CHARDEV(auth->socket));
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void emucap_auth_pause_accepts(EmucapSocketAuth *auth)
+{
+    Chardev *chr = CHARDEV(auth->socket);
+
+    if (auth->accept_resume_source) {
+        return;
+    }
+    qio_net_listener_set_client_func_full(auth->socket->listener,
+                                          NULL, NULL, NULL,
+                                          chr->gcontext);
+    auth->accept_resume_source = g_idle_source_new();
+    g_source_set_priority(auth->accept_resume_source,
+                          G_PRIORITY_DEFAULT_IDLE);
+    g_source_set_callback(auth->accept_resume_source,
+                          emucap_auth_resume_accepts, auth, NULL);
+    g_source_attach(auth->accept_resume_source, chr->gcontext);
+}
+
+static EmucapAuthCandidate *emucap_auth_oldest_unverified(
+    EmucapSocketAuth *auth)
+{
+    EmucapAuthCandidate *oldest = NULL;
+    size_t i;
+
+    for (i = 0; i < auth->candidates->len; i++) {
+        EmucapAuthCandidate *candidate =
+            g_ptr_array_index(auth->candidates, i);
+        if (!candidate->verified &&
+            (!oldest || candidate->serial < oldest->serial)) {
+            oldest = candidate;
+        }
+    }
+    return oldest;
+}
+
+static void emucap_auth_accept(QIONetListener *listener,
+                               QIOChannelSocket *cioc,
+                               void *opaque)
+{
+    Chardev *chr = CHARDEV(opaque);
+    SocketChardev *s = SOCKET_CHARDEV(chr);
+    EmucapSocketAuth *auth = s->emucap_auth;
+    EmucapAuthCandidate *candidate;
+    Error *error = NULL;
+
+    assert(auth);
+    assert(s->state == TCP_CHARDEV_STATE_DISCONNECTED);
+    if (auth->candidates->len == EMUCAP_AUTH_MAX_CANDIDATES) {
+        EmucapAuthCandidate *oldest =
+            emucap_auth_oldest_unverified(auth);
+        if (!oldest) {
+            qio_channel_shutdown(QIO_CHANNEL(cioc),
+                                 QIO_CHANNEL_SHUTDOWN_BOTH, NULL);
+            return;
+        }
+        emucap_auth_remove_candidate(oldest, true);
+    }
+    if (!qio_channel_set_blocking(QIO_CHANNEL(cioc), false, &error)) {
+        error_free(error);
+        qio_channel_shutdown(QIO_CHANNEL(cioc),
+                             QIO_CHANNEL_SHUTDOWN_BOTH, NULL);
+        return;
+    }
+    if (s->do_nodelay) {
+        qio_channel_set_delay(QIO_CHANNEL(cioc), false);
+    }
+    tcp_chr_set_client_ioc_name(chr, cioc);
+    candidate = g_new0(EmucapAuthCandidate, 1);
+    candidate->auth = auth;
+    candidate->sioc = cioc;
+    object_ref(OBJECT(cioc));
+    candidate->serial = auth->next_serial++;
+    candidate->deadline_us = g_get_monotonic_time() +
+                             EMUCAP_AUTH_TIMEOUT_MS * 1000;
+    candidate->phase = EMUCAP_AUTH_AWAIT_HELLO;
+    candidate->input_size = EMUCAP_AUTH_CLIENT_HELLO_SIZE;
+    g_ptr_array_add(auth->candidates, candidate);
+
+    candidate->timeout_source =
+        g_timeout_source_new(EMUCAP_AUTH_TIMEOUT_MS);
+    g_source_set_callback(candidate->timeout_source,
+                          emucap_auth_candidate_timeout,
+                          candidate, NULL);
+    g_source_attach(candidate->timeout_source, chr->gcontext);
+    emucap_auth_arm_candidate(candidate, G_IO_IN);
+
+    auth->accepts_this_turn++;
+    if (auth->accepts_this_turn >= EMUCAP_AUTH_ACCEPTS_PER_TURN) {
+        emucap_auth_pause_accepts(auth);
+    }
+}
+
+static bool emucap_socket_auth_init(SocketChardev *s,
+                                    ChardevSocket *sock,
+                                    Error **errp)
+{
+    EmucapSocketAuth *auth;
+    const char *token;
+    size_t token_size;
+
+    if (!sock->emucap_auth) {
+        return true;
+    }
+    token = g_getenv("EMUCAP_NATIVE_DEBUG_TOKEN");
+    token_size = token ? strlen(token) : 0;
+    if (token_size == 0 || token_size > EMUCAP_AUTH_TOKEN_MAX) {
+        error_setg(errp,
+                   "EMUCAP_NATIVE_DEBUG_TOKEN must contain 1..256 bytes");
+        return false;
+    }
+    if (!qcrypto_hmac_supports(QCRYPTO_HASH_ALGO_SHA256)) {
+        error_setg(errp, "SHA-256 HMAC is unavailable for emucap authentication");
+        return false;
+    }
+    auth = g_new0(EmucapSocketAuth, 1);
+    auth->socket = s;
+    auth->token = g_strdup(token);
+    auth->candidates = g_ptr_array_new();
+    if (strcmp(sock->emucap_auth, "xemu-qmp-v1") == 0) {
+        auth->domain = "emucap-xemu-qmp-auth-v1";
+        auth->endpoint = 1;
+    } else {
+        auth->domain = "emucap-xemu-gdb-auth-v1";
+        auth->endpoint = 2;
+    }
+    s->emucap_auth = auth;
+    return true;
+}
+
+static void emucap_socket_auth_cleanup(SocketChardev *s)
+{
+    EmucapSocketAuth *auth = s->emucap_auth;
+
+    if (!auth) {
+        return;
+    }
+    emucap_auth_cancel_accept_resume(auth);
+    while (auth->candidates->len > 0) {
+        EmucapAuthCandidate *candidate =
+            g_ptr_array_index(auth->candidates,
+                              auth->candidates->len - 1);
+        emucap_auth_remove_candidate(candidate, true);
+    }
