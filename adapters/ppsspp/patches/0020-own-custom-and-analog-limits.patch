diff --git a/Core/EmucapPacing.h b/Core/EmucapPacing.h
index f78e5738ae..ee827014d2 100644
--- a/Core/EmucapPacing.h
+++ b/Core/EmucapPacing.h
@@ -3,11 +3,22 @@
 #include <cstdint>
 #include <mutex>
 
+enum class FPSLimit {
+	NORMAL = 0,
+	CUSTOM1 = 1,
+	CUSTOM2 = 2,
+	ANALOG = 3,
+	DEBUGGER = 4,
+};
+
 // Host pacing state. Readers take a value snapshot and release the lock before
 // any core, audio, UI, socket or lifecycle operation.
 struct EmucapPacingSnapshot {
     int percent = 100;
     bool fastForward = false;
+    FPSLimit fpsLimit = FPSLimit::NORMAL;
+    int analogFpsLimit = 0;
+    int debuggerFpsLimit = 0;
     uint32_t revision = 0;
 };
 
@@ -48,6 +59,38 @@ class EmucapPacingOwner {
         return {previous, policy_};
     }
 
+    bool ChangeLimit(FPSLimit expected, FPSLimit next) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        if (policy_.fpsLimit != expected)
+            return false;
+        policy_.fpsLimit = next;
+        ++policy_.revision;
+        return true;
+    }
+
+    void CycleLimit(bool custom1Enabled, bool custom2Enabled) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        const auto previous = policy_.fpsLimit;
+        if (previous == FPSLimit::NORMAL && custom1Enabled)
+            policy_.fpsLimit = FPSLimit::CUSTOM1;
+        else if (previous == FPSLimit::CUSTOM1 && custom2Enabled)
+            policy_.fpsLimit = FPSLimit::CUSTOM2;
+        else if (previous == FPSLimit::CUSTOM1 || previous == FPSLimit::CUSTOM2)
+            policy_.fpsLimit = FPSLimit::NORMAL;
+        if (policy_.fpsLimit != previous)
+            ++policy_.revision;
+    }
+
+    bool SetAnalogLimit(int fps) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        if (policy_.fpsLimit != FPSLimit::NORMAL && policy_.fpsLimit != FPSLimit::ANALOG)
+            return false;
+        policy_.analogFpsLimit = fps;
+        policy_.fpsLimit = fps == 60 ? FPSLimit::NORMAL : FPSLimit::ANALOG;
+        ++policy_.revision;
+        return true;
+    }
+
 private:
     bool initialized_ = false;
     mutable std::mutex mutex_;
