+    if (g_emucapFrameStep.status == EmucapFrameStepStatus::Running) return false;
+    g_debuggerStop = {std::move(completed), std::move(connected),
+        std::chrono::steady_clock::now() + std::chrono::seconds(240), {}, false};
+    Core_EmucapInvalidateMemoryPark();
+    return true;
+}
+
+// CPU-owner service; a lost connection cannot leave a temporary run armed indefinitely.
+static void Core_PollDebuggerStop() {
+    std::lock_guard<std::recursive_mutex> guard(g_stepMutex);
+    if (!g_debuggerStop.completed) return;
+    const auto now = std::chrono::steady_clock::now();
+    if (!g_debuggerStop.stopping &&
+        ((g_debuggerStop.connected && !g_debuggerStop.connected()) || now >= g_debuggerStop.deadline)) {
+        g_debuggerStop.stopping = true;
+        g_debuggerStop.cleanupDeadline = now + std::chrono::seconds(2);
+        if (coreState == CORE_RUNNING_CPU) Core_Break(BreakReason::DebugBreak, 0);
+    }
+    if (g_debuggerStop.stopping && now >= g_debuggerStop.cleanupDeadline && !Core_EmucapMemoryParked())
+        std::abort();
+}
+
+static bool Core_PublishDebuggerStop(std::unique_lock<std::recursive_mutex> &guard) {
+    if (!g_debuggerStop.completed || !Core_EmucapMemoryParked()) return false;
+    auto owner = std::move(g_debuggerStop);
+    g_debuggerStop = {};
+    guard.unlock();
+    if (!owner.connected || owner.connected()) owner.completed();
+    return true;
+}
