diff --git a/Core/EmucapPacing.h b/Core/EmucapPacing.h
index 5c2398c940..86c1e922a1 100644
--- a/Core/EmucapPacing.h
+++ b/Core/EmucapPacing.h
@@ -49,6 +49,21 @@ struct EmucapPacingApply {
 
 class EmucapPacingOwner {
 public:
+    bool ApplyDebuggerSpeed(bool hasFastForward, bool fastForward, bool hasPercent, bool clearPercent, int fps) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        if (policy_.NetworkForced()) return false;
+        if (hasFastForward) policy_.fastForward = fastForward;
+        if (clearPercent) {
+            if (policy_.fpsLimit == FPSLimit::DEBUGGER) policy_.fpsLimit = FPSLimit::NORMAL;
+            policy_.debuggerFpsLimit = 0;
+        } else if (hasPercent) {
+            policy_.debuggerFpsLimit = fps;
+            policy_.fpsLimit = FPSLimit::DEBUGGER;
+        }
+        ++policy_.revision;
+        return true;
+    }
+
     EmucapPacingApply ApplySpeed(int percent) {
         std::lock_guard<std::mutex> guard(mutex_);
         const auto previous = policy_;
@@ -57,6 +72,7 @@ class EmucapPacingOwner {
         policy_.percent = percent;
         policy_.fastForward = false;
         policy_.fpsLimit = FPSLimit::NORMAL;
+        policy_.debuggerFpsLimit = 0;
         ++policy_.revision;
         return {true, previous, policy_};
 
