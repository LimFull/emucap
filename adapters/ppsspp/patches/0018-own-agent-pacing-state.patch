diff --git a/Core/EmucapPacing.h b/Core/EmucapPacing.h
new file mode 100644
index 0000000000..a92819eb32
--- /dev/null
+++ b/Core/EmucapPacing.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+
+// Host pacing state. Readers take a value snapshot and release the lock before
+// any core, audio, UI, socket or lifecycle operation.
+struct EmucapPacingSnapshot {
+    int percent = 100;
+    uint32_t revision = 0;
+};
+
+struct EmucapPacingUpdate {
+    EmucapPacingSnapshot previous;
+    EmucapPacingSnapshot applied;
+};
+
+class EmucapPacingOwner {
+public:
+    EmucapPacingSnapshot Read() const {
+        std::lock_guard<std::mutex> guard(mutex_);
+        return policy_;
+    }
+
+    EmucapPacingUpdate SetPercent(int percent) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        const auto previous = policy_;
+        policy_.percent = percent;
+        ++policy_.revision;
+        return {previous, policy_};
+    }
+
+private:
+    mutable std::mutex mutex_;
+    EmucapPacingSnapshot policy_;
+};
