+std::function<void()> WebSocketSteppingReceipt(const DebuggerRequest &req) {
+	const JsonNode *value = req.data.get("ticket");
+	if (!value || !req.client->executionReceipt) return {};
+	std::string ticket = json_stringify(value);
+	auto deliver = req.client->executionReceipt;
+	return [ticket = std::move(ticket), deliver = std::move(deliver)] {
+		// Invoked by the owning native step, never by an unrelated broadcast.
+		std::string terminal = SteppingBroadcaster::CurrentState();
+		if (terminal.empty()) return;
+		terminal.insert(1, "\"ticket\":" + ticket + ",");
+		deliver(std::move(terminal));
+	};
+}
