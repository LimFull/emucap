+static bool EmucapDebuggerRequestAuthenticated(const http::ServerRequest &request) {
+	static constexpr char AUTH_PREFIX[] = "Bearer ";
+	static constexpr char MANAGED_ORIGIN[] = "https://emucap.invalid";
+	static constexpr size_t MAX_TOKEN_BYTES = 512;
+
+	const char *expected = getenv("EMUCAP_NATIVE_DEBUG_TOKEN");
+	if (expected == nullptr || expected[0] == '\0') {
+		return false;
+	}
+	size_t expectedLen = 0;
+	while (expectedLen <= MAX_TOKEN_BYTES && expected[expectedLen] != '\0') {
+		expectedLen++;
+	}
+	if (expectedLen == 0 || expectedLen > MAX_TOKEN_BYTES) {
+		return false;
+	}
+
+	std::string origin;
+	std::string authorization;
+	if (!request.GetHeader("origin", &origin) || origin != MANAGED_ORIGIN ||
+		!request.GetHeader("authorization", &authorization)) {
+		return false;
+	}
+	const size_t prefixLen = sizeof(AUTH_PREFIX) - 1;
+	if (authorization.size() != prefixLen + expectedLen ||
+		authorization.compare(0, prefixLen, AUTH_PREFIX) != 0) {
+		return false;
+	}
+
+	unsigned int difference = 0;
+	for (size_t i = 0; i < expectedLen; i++) {
+		difference |= static_cast<unsigned char>(authorization[prefixLen + i]) ^
+			static_cast<unsigned char>(expected[i]);
+	}
+	return difference == 0;
+}
