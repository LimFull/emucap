@@ -130,6 +138,39 @@ class EmucapPacingOwner {
         }
     }
 
+    void PublishAdhocState(int &nativeState, int next, bool connected) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        nativeState = next;
+        if (policy_.adhocState != next || policy_.adhocStateConnected != connected) {
+            policy_.adhocState = next;
+            policy_.adhocStateConnected = connected;
+            ++policy_.revision;
+        }
+    }
+
+    void PublishAdhocInit(bool &nativeFlag, bool value, bool control) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        nativeFlag = value;
+        bool &flag = control ? policy_.adhocctlInited : policy_.adhocInited;
+        if (flag != value) { flag = value; ++policy_.revision; }
+    }
+
+    void RestoreAdhoc(int &state, bool &initialized, bool &controlInitialized,
+        int next, bool connected, bool init, bool controlInit) {
+        std::lock_guard<std::mutex> guard(mutex_);
+        state = next;
+        initialized = init;
+        controlInitialized = controlInit;
+        if (policy_.adhocState != next || policy_.adhocStateConnected != connected ||
+            policy_.adhocInited != init || policy_.adhocctlInited != controlInit) {
+            policy_.adhocState = next;
+            policy_.adhocStateConnected = connected;
+            policy_.adhocInited = init;
+            policy_.adhocctlInited = controlInit;
+            ++policy_.revision;
+        }
+    }
+
 private:
     bool initialized_ = false;
     mutable std::mutex mutex_;
