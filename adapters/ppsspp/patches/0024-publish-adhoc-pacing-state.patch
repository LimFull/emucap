+    int adhocState = 0;
+    bool adhocInited = false;
+    bool adhocctlInited = false;
+    bool adhocStateConnected = false;
+    bool NetworkConnected() const {
+        return apctlConnected || (adhocInited && adhocctlInited && adhocStateConnected);
+    }
