+// Output readback has request-owned storage: a timed-out read must never satisfy
+// a later capture or expose a buffer while the GPU thread is still writing it.
+struct OutputReadRequest {
+	CoreState state;
+	int cpuStop;
+	int gpuStop;
+	bool started = false;
+	bool done = false;
+	bool cancelled = false;
+	bool success = false;
+	std::shared_ptr<GPUDebugBuffer> buffer = std::make_shared<GPUDebugBuffer>();
+};
+static std::mutex outputReadLock;
+static std::condition_variable outputReadWait;
+static std::shared_ptr<OutputReadRequest> outputRead;
+
+void CancelOutputRead() {
+	std::lock_guard<std::mutex> lock(outputReadLock);
+	if (outputRead) {
+		outputRead->cancelled = true;
+		outputRead->success = false;
+		outputRead->done = true;
+		outputReadWait.notify_all();
+	}
+}
+
+static bool SameOutputStop(const OutputReadRequest &request) {
+	return coreState == request.state &&
+		Core_GetSteppingCounter() == request.cpuStop &&
+		GetSteppingCounter() == request.gpuStop;
+}
+
+// Match the native game-screenshot source, not the host swapchain (which may
+// already be cleared for a new UI frame). Copy even memory-backed results: their
+// borrowed guest storage must not escape the halted read operation.
+static bool ReadDisplayOutput(GPUDebugBuffer &output) {
+	GPUDebugBuffer source;
+	if (!gpu || !gpu->GetCurrentFramebuffer(source, GPU_DBG_FRAMEBUF_DISPLAY, 1) ||
+		source.IsBackBuffer() || !source.GetData() || source.GetStride() < 480 || source.GetHeight() < 272)
+		return false;
+	output.Allocate(480, 272, source.GetFormat(), source.GetFlipped());
+	const u32 pixelSize = source.PixelSize();
+	const u32 firstRow = source.GetFlipped() ? source.GetHeight() - 272 : 0;
+	for (u32 y = 0; y < 272; ++y) {
+		memcpy(output.GetData() + y * 480 * pixelSize,
+			source.GetData() + (firstRow + y) * source.GetStride() * pixelSize, 480 * pixelSize);
+	}
+	return true;
+}
+
+// Called only on the emulation thread, which already owns the GPU debug path.
+static void ProcessOutputRead() {
+	std::shared_ptr<OutputReadRequest> request;
+	{
+		std::lock_guard<std::mutex> lock(outputReadLock);
+		request = outputRead;
+		if (!request || request->started || request->cancelled)
+			return;
+		request->started = true;
+	}
+	// Do not hold the mailbox lock during a potentially blocking host GPU read.
+	bool success = gpu && SameOutputStop(*request) &&
+		ReadDisplayOutput(*request->buffer) && SameOutputStop(*request) &&
+		request->buffer->GetData() && request->buffer->GetStride() && request->buffer->GetHeight();
+	{
+		std::lock_guard<std::mutex> lock(outputReadLock);
+		request->success = success && !request->cancelled;
+		request->done = true;
+		outputReadWait.notify_all();
+	}
+}
+
+std::shared_ptr<GPUDebugBuffer> GPU_ReadDisplayFramebuffer() {
+	_dbg_assert_(strcmp(GetCurrentThreadName(), "EmuThread") != 0);
+	std::unique_lock<std::mutex> lock(outputReadLock);
+	if (outputRead || (coreState != CORE_STEPPING_CPU && coreState != CORE_STEPPING_GE))
+		return {};
+	auto request = std::make_shared<OutputReadRequest>();
+	request->state = coreState;
+	request->cpuStop = Core_GetSteppingCounter();
+	request->gpuStop = GetSteppingCounter();
+	outputRead = request;
+	const bool completed = outputReadWait.wait_for(lock, std::chrono::seconds(5), [&] {
+		return request->done;
+	});
+	if (!completed)
+		request->cancelled = true;
+	outputRead.reset();
+	if (!completed || !request->success || !SameOutputStop(*request))
+		return {};
+	return request->buffer;
+}
+
 bool ProcessStepping() {
+	ProcessOutputRead();
 	_dbg_assert_(gpu);
 
 	std::unique_lock<std::mutex> guard(pauseLock);
