+bool Core_EmucapBeginFrameStep(u32 count, u64 startVblank) {
+	std::lock_guard<std::mutex> guard(g_emucapFrameStepMutex);
+	if (count == 0 || coreState != CORE_STEPPING_CPU || g_emucapFrameStep.status == EmucapFrameStepStatus::Running)
+		return false;
+	g_emucapFrameStep.status = EmucapFrameStepStatus::Running;
+	g_emucapFrameStep.requested = count;
+	g_emucapFrameStep.completed = 0;
+	g_emucapFrameStep.startVblank = startVblank;
+	g_emucapFrameStep.endVblank = startVblank;
+	g_emucapFrameStepFinishing = false;
+	return true;
+}
+
+EmucapFrameStepResult Core_EmucapWaitFrameStep(u32 timeoutMilliseconds) {
+	std::unique_lock<std::mutex> guard(g_emucapFrameStepMutex);
+	if (g_emucapFrameStep.status == EmucapFrameStepStatus::Running) {
+		const bool stopped = g_emucapFrameStepCond.wait_for(
+			guard,
+			std::chrono::milliseconds(timeoutMilliseconds),
+			[] { return g_emucapFrameStep.status != EmucapFrameStepStatus::Running; });
+		if (!stopped) {
+			EmucapFrameStepResult timedOut = g_emucapFrameStep;
+			timedOut.status = EmucapFrameStepStatus::TimedOut;
+			return timedOut;
+		}
+	}
+	return g_emucapFrameStep;
+}
+
+EmucapFrameStepResult Core_EmucapCancelFrameStep() {
+	std::lock_guard<std::mutex> guard(g_emucapFrameStepMutex);
+	if (g_emucapFrameStep.status == EmucapFrameStepStatus::Running)
+		g_emucapFrameStep.status = EmucapFrameStepStatus::Interrupted;
+	g_emucapFrameStepFinishing = false;
+	g_emucapFrameStepCond.notify_all();
+	return g_emucapFrameStep;
+}
+
+static void Core_EmucapObserveBreak(BreakReason reason) {
+	std::lock_guard<std::mutex> guard(g_emucapFrameStepMutex);
+	if (g_emucapFrameStep.status != EmucapFrameStepStatus::Running)
+		return;
+	g_emucapFrameStep.status = g_emucapFrameStepFinishing && reason == BreakReason::FrameAdvance
+		? EmucapFrameStepStatus::Completed
+		: EmucapFrameStepStatus::Interrupted;
+	g_emucapFrameStepFinishing = false;
+	g_emucapFrameStepCond.notify_all();
+}
+
+void Core_EmucapFrameBoundary(u64 vblank) {
+	bool shouldBreak = false;
+	{
+		std::lock_guard<std::mutex> guard(g_emucapFrameStepMutex);
+		if (g_emucapFrameStep.status != EmucapFrameStepStatus::Running)
+			return;
+		g_emucapFrameStep.completed++;
+		g_emucapFrameStep.endVblank = vblank;
+		if (g_emucapFrameStep.completed >= g_emucapFrameStep.requested) {
+			g_emucapFrameStepFinishing = true;
+			shouldBreak = true;
+		}
+	}
+	if (shouldBreak)
+		Core_Break(BreakReason::FrameAdvance, (u32)vblank);
+}
