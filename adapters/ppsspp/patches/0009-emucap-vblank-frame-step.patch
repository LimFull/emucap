+// Advance by an exact number of emulated PSP VBlank-start boundaries and halt again.  Host
+// presentation is intentionally not part of this contract: headless and displayed runs share the
+// same emulated clock.  A breakpoint or other Core_Break wins and reports an interrupted partial
+// advance.  The bounded wait leaves enough time for the bridge to receive the terminal reply.
+void WebSocketSteppingState::Frame(DebuggerRequest &req) {
+	if (!currentDebugMIPS->isAlive())
+		return req.Fail("CPU not started");
+	if (coreState != CORE_STEPPING_CPU)
+		return req.Fail("CPU must be halted before emucap.frameStep");
+
+	uint32_t count = 0;
+	if (!req.ParamU32("count", &count))
+		return;
+	if (count == 0 || count > 5000)
+		return req.Fail("count must be between 1 and 5000");
+
+	const u64 startVblank = (u64)__DisplayGetNumVblanks();
+	if (!Core_EmucapBeginFrameStep(count, startVblank))
+		return req.Fail("another frame advance is active or the CPU is not halted");
+
+	Core_Resume();
+	EmucapFrameStepResult result = Core_EmucapWaitFrameStep(240000);
+	if (result.status == EmucapFrameStepStatus::TimedOut) {
+		Core_Break(BreakReason::DebugBreak, 0);
+		Core_WaitInactive();
+		Core_EmucapCancelFrameStep();
+		return req.Fail("frame advance timed out after 240000 ms; CPU halt was requested");
+	}
+
+	Core_WaitInactive();
+	JsonWriter &json = req.Respond();
+	json.writeString("status", result.status == EmucapFrameStepStatus::Completed ? "completed" : "interrupted");
+	json.writeString("unit", "frames");
+	json.writeUint("count", result.requested);
+	json.writeUint("completed", result.completed);
+	json.writeUint("start_vblank", (uint32_t)result.startVblank);
+	json.writeUint("end_vblank", (uint32_t)result.endVblank);
+	json.writeString("state", "frozen");
+}
