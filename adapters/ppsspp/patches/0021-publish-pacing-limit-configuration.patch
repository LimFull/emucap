-    bool SetAnalogLimit(int fps) {
+    bool SetAnalogInput(float amount) {
         std::lock_guard<std::mutex> guard(mutex_);
         if (policy_.fpsLimit != FPSLimit::NORMAL && policy_.fpsLimit != FPSLimit::ANALOG)
             return false;
+        if (policy_.analogTargetFps <= 0)
+            return false;
+        const int fps = 60 + (int)((policy_.analogTargetFps - 60) * amount);
         policy_.analogFpsLimit = fps;
