+bool Core_ConsumeHeadlessReset();          // run loop: true (and clears pending) if a reset is due
+void Core_NotifyHeadlessResetDone();       // run loop: one reset completed
+uint64_t Core_HeadlessResetGeneration();   // completed-reset counter; snapshot it before requesting
+bool Core_WaitHeadlessReset(uint64_t sinceGeneration, double timeoutSeconds);  // block until it advances
