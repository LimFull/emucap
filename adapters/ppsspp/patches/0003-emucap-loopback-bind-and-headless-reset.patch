@@ -90,10 +90,21 @@ void WebSocketGameReset(DebuggerRequest &req) {
 	if (!running)
 		return req.Fail("Game not running");
 
+	// emucap: snapshot the completed-reset generation *before* requesting, so a reset that finishes
+	// between here and the wait below is still observed (the wait predicate is already satisfied).
+	uint64_t resetGen = Core_HeadlessResetGeneration();
+
 	// We can only support async resets here. A lot of the stuff in init must happen on the EmuThread,
 	// and we are not on it here.
 	System_PostUIMessage(UIMessage::REQUEST_GAME_RESET);
 
+	// Wait outside the CPU queue so the run loop can perform and acknowledge reboot.
+	if (Core_HeadlessResetMode()) {
+		bool completed = Core_WaitHeadlessReset(resetGen, 30.0);
+		if (!completed)
+			return req.Fail("Reset timed out waiting for the headless reboot to complete");
+	}
+
 	req.Respond();
 }
 
