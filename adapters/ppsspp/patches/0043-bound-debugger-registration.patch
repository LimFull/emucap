+// Called only in the CPU-thread mutation transaction. Temporary stepping and
+// the fixed register set have independent bounds; existing points may be updated.
+static bool AdmitRemoteBreakpoint(bool replacing, std::string *error) {
+	constexpr size_t limit = 128;
+	const size_t exec = g_breakpoints.GetBreakpointRefs().size();
+	const size_t memory = g_breakpoints.GetMemCheckRefs().size();
+	if (!replacing && (exec >= limit || memory >= limit - exec)) {
+		*error = "Breakpoint limit exceeded (128 CPU/memory registrations)";
+		return false;
+	}
+	return true;
+}
 
