+// Copyright 2026 emucap contributors
+// Licensed under GPLv2 or any later version
+
+#include <algorithm>
+#include <deque>
+#include <optional>
+#include <vector>
+
+#include "core/arm/skyeye_common/armstate.h"
+#include "core/core.h"
+#include "core/emucap_debug.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/process.h"
+
+namespace EmucapDebug {
+
+namespace {
+
+constexpr std::size_t MAX_POINTS = 128;
+constexpr std::size_t MAX_EVENTS = 256;
+
+enum class StepState { None, Armed, Started };
+
+std::vector<Point> points;
+std::deque<Event> events;
+u64 dropped_events = 0;
+u64 next_sequence = 1;
+u64 application_id = 0;
+bool stop_requested = false;
+u32 stop_reason = StopReason::None;
+StepState step = StepState::None;
+/// An exec stop leaves the guest before that instruction; the next run must execute it once.
+std::optional<u32> resume_skip_pc;
+
+void Refresh() {
+    active = !points.empty() || step != StepState::None || stop_requested ||
+             resume_skip_pc.has_value();
+}
+
+bool InApplication() {
+    const auto process = Core::System::GetInstance().Kernel().GetCurrentProcess();
+    return process && process->codeset && process->codeset->program_id == application_id;
+}
+
+void Record(const ARMul_State& cpu, const Point& point, u32 address, u32 size, u32 value) {
+    if (events.size() == MAX_EVENTS) {
+        events.pop_front();
+        ++dropped_events;
+    }
+    Event event{};
+    event.sequence = next_sequence++;
+    event.breakpoint_id = point.id;
+    event.kind = point.kind;
+    event.address = address;
+    event.size = size;
+    event.value = value;
+    event.paused = point.pause_on_hit;
+    std::copy(cpu.Reg.begin(), cpu.Reg.end(), event.registers);
+    // The interpreter keeps the condition flags outside CPSR while it runs.
+    event.registers[16] = (cpu.Cpsr & 0x0FFFFFDF) | (cpu.NFlag << 31) | (cpu.ZFlag << 30) |
+                          (cpu.CFlag << 29) | (cpu.VFlag << 28) | (cpu.TFlag << 5);
+    events.push_back(event);
+}
+
+} // namespace
+
+bool active = false;
+
+bool BeforeInstruction(ARMul_State& cpu) {
+    if (stop_requested) {
+        return true;
+    }
+    const u32 pc = cpu.Reg[15];
+    const bool exec_candidate = std::any_of(points.begin(), points.end(), [pc](const Point& p) {
+        return p.kind == Kind::Exec && p.start <= pc && pc <= p.end;
+    });
+    if (!exec_candidate && step == StepState::None && !resume_skip_pc) {
+        return false;
+    }
+    if (!InApplication()) {
+        return false;
+    }
+    bool skipped = false;
+    if (resume_skip_pc) {
+        skipped = *resume_skip_pc == pc;
+        resume_skip_pc.reset();
+    }
+    bool stop = false;
+    bool exec_stop = false;
+    if (exec_candidate && !skipped) {
+        for (const auto& point : points) {
+            if (point.kind == Kind::Exec && point.start <= pc && pc <= point.end) {
+                Record(cpu, point, pc, cpu.TFlag ? 2 : 4, 0);
+                exec_stop |= point.pause_on_hit != 0;
+            }
+        }
+        stop = exec_stop;
+    }
+    if (step == StepState::Started) {
+        step = StepState::None;
+        stop = true;
+    } else if (step == StepState::Armed && !stop) {
+        step = StepState::Started;
+    }
+    if (stop) {
+        stop_requested = true;
+        stop_reason = exec_stop ? StopReason::Breakpoint : StopReason::Step;
+        if (exec_stop) {
+            resume_skip_pc = pc;
+        }
+    }
+    Refresh();
+    return stop;
+}
+
+void OnAccess(const ARMul_State& cpu, u32 address, u32 size, bool write, u64 value) {
+    const u64 last = static_cast<u64>(address) + size - 1;
+    bool checked = false;
+    for (const auto& point : points) {
+        const bool direction = point.kind == Kind::Access ||
+                               point.kind == (write ? Kind::Write : Kind::Read);
+        if (!direction || last < point.start || address > point.end) {
+            continue;
+        }
+        if (!checked) {
+            if (!InApplication()) {
+                return;
+            }
+            checked = true;
+        }
+        Record(cpu, point, address, size, size <= 4 ? static_cast<u32>(value) : 0);
+        if (point.pause_on_hit) {
+            // The access completes; the guest stops before its next instruction.
+            stop_requested = true;
+            stop_reason = StopReason::Breakpoint;
+        }
+    }
+    Refresh();
+}
+
+bool StopRequested() {
+    return stop_requested;
+}
+
+bool AddPoint(const Point& point) {
+    if (points.size() == MAX_POINTS || point.kind > Kind::Access || point.end < point.start ||
+        std::any_of(points.begin(), points.end(), [&](const Point& p) { return p.id == point.id; })) {
+        return false;
+    }
+    points.push_back(point);
+    Refresh();
+    return true;
+}
+
+bool RemovePoint(u64 id) {
+    const auto removed = std::erase_if(points, [id](const Point& p) { return p.id == id; });
+    Refresh();
+    return removed != 0;
+}
+
+void ClearPoints() {
+    points.clear();
+    Refresh();
+}
+
+bool PollEvent(Event& event) {
+    if (events.empty()) {
+        return false;
+    }
+    event = events.front();
+    events.pop_front();
+    return true;
+}
+
+u64 TakeDroppedEvents() {
+    return std::exchange(dropped_events, 0);
+}
+
+void Resume(u64 program_id) {
+    application_id = program_id;
+    stop_requested = false;
+    stop_reason = StopReason::None;
+    Refresh();
+}
+
+void RequestStep(bool armed) {
+    step = armed ? StepState::Armed : StepState::None;
+    Refresh();
+}
+
+u32 TakeStopReason() {
+    return std::exchange(stop_reason, StopReason::None);
+}
+
+} // namespace EmucapDebug
