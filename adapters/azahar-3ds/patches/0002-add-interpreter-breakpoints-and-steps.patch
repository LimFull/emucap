@@ -0,0 +1,58 @@
+// Copyright 2026 emucap contributors
+// Licensed under GPLv2 or any later version
+
+// emucap debugger state for the dyncom interpreter. Everything runs on the emulation thread:
+// the interpreter consults it, and the frontend changes it only between retro_run calls.
+
+#pragma once
+
+#include <cstddef>
+#include "common/common_types.h"
+
+class ARMul_State;
+
+namespace EmucapDebug {
+
+enum Kind : u32 { Exec = 0, Read = 1, Write = 2, Access = 3 };
+enum StopReason : u32 { None = 0, Breakpoint = 1, Step = 2 };
+constexpr std::size_t REGISTER_COUNT = 17; // r0-r15 and CPSR
+
+struct Point {
+    u64 id;
+    u32 kind;
+    u32 start; // inclusive virtual address range
+    u32 end;
+    u32 pause_on_hit;
+};
+
+struct Event {
+    u64 sequence;
+    u64 breakpoint_id;
+    u32 kind;
+    u32 address;
+    u32 size;
+    u32 value; // valid for accesses of at most four bytes
+    u32 paused;
+    u32 registers[REGISTER_COUNT];
+};
+
+/// Hot-path guard: true while any point, step or stop is pending.
+extern bool active;
+
+/// Called before each interpreted instruction; true stops before it executes.
+bool BeforeInstruction(ARMul_State& cpu);
+/// Called for each data load or store by the interpreter.
+void OnAccess(const ARMul_State& cpu, u32 address, u32 size, bool write, u64 value);
+bool StopRequested();
+
+bool AddPoint(const Point& point);
+bool RemovePoint(u64 id);
+void ClearPoints();
+bool PollEvent(Event& event);
+u64 TakeDroppedEvents();
+/// Clears a stop before the next run. Points apply only to the title `program_id`.
+void Resume(u64 program_id);
+void RequestStep(bool armed);
+u32 TakeStopReason();
+
+} // namespace EmucapDebug
