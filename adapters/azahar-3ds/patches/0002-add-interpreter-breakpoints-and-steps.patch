+/// Disassembles one ARM (thumb == 0) or Thumb instruction of the application into `text`.
+EMUCAP_EXPORT int emucap_azahar_disassemble(std::uint32_t address, int thumb, char* text,
+                                            std::size_t capacity, std::uint32_t* length) {
+    auto process = ApplicationProcess();
+    auto& memory = Core::System::GetInstance().Memory();
+    if (!process || !text || capacity == 0 || !length) {
+        return 0;
+    }
+    std::string row;
+    if (!thumb) {
+        std::uint32_t word = 0;
+        if ((address & 3) != 0 || !RangeMapped(memory, *process, address, 4)) {
+            return 0;
+        }
+        memory.ReadBlock(*process, address, &word, 4);
+        row = Dynarmic::A32::DisassembleArm(word);
+        *length = 4;
+    } else {
+        std::uint16_t first = 0;
+        if ((address & 1) != 0 || !RangeMapped(memory, *process, address, 2)) {
+            return 0;
+        }
+        memory.ReadBlock(*process, address, &first, 2);
+        if ((first >> 11) >= 0x1D) {
+            // 32-bit Thumb: decode the BL/BLX call pair, which dominates call tracing.
+            std::uint16_t second = 0;
+            if (!RangeMapped(memory, *process, address + 2, 2)) {
+                return 0;
+            }
+            memory.ReadBlock(*process, address + 2, &second, 2);
+            *length = 4;
+            const bool bl = (first >> 11) == 0x1E && (second >> 11) == 0x1F;
+            const bool blx = (first >> 11) == 0x1E && (second >> 11) == 0x1D;
+            if (bl || blx) {
+                std::int32_t offset = ((first & 0x7FF) << 12) | ((second & 0x7FF) << 1);
+                offset = (offset << 9) >> 9; // sign-extend the 23-bit offset
+                std::uint32_t target = address + 4 + offset;
+                if (blx) {
+                    target &= ~3u;
+                }
+                char buffer[48];
+                std::snprintf(buffer, sizeof(buffer), "%s #0x%08x", bl ? "bl" : "blx", target);
+                row = buffer;
+            } else {
+                char buffer[48];
+                std::snprintf(buffer, sizeof(buffer), "<thumb32 %04x %04x>", first, second);
+                row = buffer;
+            }
+        } else {
+            row = Dynarmic::A32::DisassembleThumb16(first);
+            *length = 2;
+        }
+    }
+    const std::size_t count = std::min(row.size(), capacity - 1);
+    std::memcpy(text, row.data(), count);
+    text[count] = '\0';
     return 1;
 }
