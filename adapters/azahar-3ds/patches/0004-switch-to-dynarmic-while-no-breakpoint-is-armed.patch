+void System::EmucapUseInterpreter(bool interpreter) {
+#if CITRA_ARCH(x86_64) || CITRA_ARCH(arm64)
+    if (cpu_cores.empty() ||
+        (dynamic_cast<ARM_DynCom*>(cpu_cores[0].get()) != nullptr) == interpreter) {
+        return;
+    }
+    std::vector<std::shared_ptr<ARM_Interface>> next;
+    ARM_Interface* next_running = nullptr;
+    for (u32 i = 0; i < cpu_cores.size(); ++i) {
+        const ARM_Interface& old = *cpu_cores[i];
+        std::shared_ptr<ARM_Interface> cpu;
+        if (interpreter) {
+            cpu = std::make_shared<ARM_DynCom>(*this, *memory, USER32MODE, i, timing->GetTimer(i));
+        } else {
+            cpu = std::make_shared<ARM_Dynarmic>(*this, *memory, i, timing->GetTimer(i),
+                                                 *exclusive_monitor);
+        }
+        // The same state ARM_Interface serializes, so a switch is a save and load.
+        if (old.GetPageTable()) {
+            cpu->SetPageTable(old.GetPageTable());
+        }
+        for (int r = 0; r < 15; r++) {
+            cpu->SetReg(r, old.GetReg(r));
+        }
+        cpu->SetPC(old.GetPC());
+        cpu->SetCPSR(old.GetCPSR());
+        for (int r = 0; r < 64; r++) {
+            cpu->SetVFPReg(r, old.GetVFPReg(r));
+        }
+        cpu->SetVFPSystemReg(VFP_FPSCR, old.GetVFPSystemReg(VFP_FPSCR));
+        cpu->SetVFPSystemReg(VFP_FPEXC, old.GetVFPSystemReg(VFP_FPEXC));
+        cpu->SetCP15Register(CP15_THREAD_UPRW, old.GetCP15Register(CP15_THREAD_UPRW));
+        cpu->SetCP15Register(CP15_THREAD_URO, old.GetCP15Register(CP15_THREAD_URO));
+        cpu->break_flag = old.break_flag;
+        if (running_core == cpu_cores[i].get()) {
+            next_running = cpu.get();
+        }
+        next.push_back(std::move(cpu));
+    }
+    kernel->SetCPUs(next);
+    kernel->SetRunningCPU(next_running ? next_running : next[0].get());
+    running_core = next_running ? next_running : next[0].get();
+    cpu_cores = std::move(next);
+#endif
 }
 
