+	void accept_candidates()
+	{
+		for (std::size_t count = 0; count < accept_limit && m_listener.is_open(); ++count)
+		{
+			asio::ip::tcp::socket socket(m_context);
+			asio::error_code error;
+			m_listener.accept(socket, error);
+			if (idle(error)) return;
+			if (error) { close(); return; }
+			socket.non_blocking(true, error);
+			if (!error) socket.set_option(asio::ip::tcp::no_delay(true), error);
+			if (error) { socket.close(); continue; }
+			if (m_candidates.size() == candidate_limit)
+			{
+				auto victim = std::find_if(m_candidates.begin(), m_candidates.end(),
+					[] (auto const &candidate) { return !candidate->verified; });
+				if (victim == m_candidates.end()) { socket.close(); continue; }
+				asio::error_code ignored;
+				(*victim)->socket.close(ignored);
+				m_candidates.erase(victim);
+			}
+			m_candidates.emplace_back(std::make_unique<candidate>(std::move(socket)));
+		}
+	}
