+	static void append_field(util::sha1_creator &hash, std::string_view field)
+	{
+		std::array<std::uint8_t, 8> length;
+		auto value = std::uint64_t(field.size());
+		for (int index = 7; index >= 0; --index)
+		{
+			length[index] = std::uint8_t(value);
+			value >>= 8;
+		}
+		hash.append(length.data(), length.size());
+		hash.append(field.data(), field.size());
+	}
+
+	static std::string hmac_sha1(std::string_view key, std::string_view direction,
+			std::string_view client_nonce, std::string_view server_nonce)
+	{
+		constexpr std::size_t block_size = 64;
+		std::array<std::uint8_t, block_size> key_block{};
+		if (key.size() > key_block.size())
+		{
+			auto const digest = util::sha1_creator::simple(key.data(), key.size());
+			std::copy(std::begin(digest.m_raw), std::end(digest.m_raw), key_block.begin());
+		}
+		else
+		{
+			std::copy(key.begin(), key.end(), key_block.begin());
+		}
+		std::array<std::uint8_t, block_size> inner_pad;
+		std::array<std::uint8_t, block_size> outer_pad;
+		for (std::size_t index = 0; index < block_size; ++index)
+		{
+			inner_pad[index] = key_block[index] ^ 0x36;
+			outer_pad[index] = key_block[index] ^ 0x5c;
+		}
+		util::sha1_creator inner;
+		inner.append(inner_pad.data(), inner_pad.size());
+		append_field(inner, "emucap-mame-native-auth-v1");
+		append_field(inner, direction);
+		append_field(inner, client_nonce);
+		append_field(inner, server_nonce);
+		auto const inner_digest = inner.finish();
+		util::sha1_creator outer;
+		outer.append(outer_pad.data(), outer_pad.size());
+		outer.append(inner_digest.m_raw, sizeof(inner_digest.m_raw));
+		return outer.finish().as_string();
+	}
+
+	static bool constant_time_equal(std::string_view left, std::string_view right)
+	{
+		unsigned difference = unsigned(left.size() ^ right.size());
+		for (std::size_t index = 0; index < left.size(); ++index)
+			difference |= std::uint8_t(left[index]) ^ std::uint8_t(index < right.size() ? right[index] : 0);
+		return difference == 0;
+	}
+
+	static std::string frame(std::string_view payload)
+	{
+		std::uint8_t checksum = 0;
+		for (auto const ch : payload) checksum += std::uint8_t(ch);
+		static constexpr char digits[] = "0123456789abcdef";
+		std::string result;
+		result.reserve(payload.size() + 4);
+		result.push_back('$');
+		result.append(payload);
+		result.push_back('#');
+		result.push_back(digits[checksum >> 4]);
+		result.push_back(digits[checksum & 15]);
+		return result;
+	}
+
+	static frame_result take_frame(candidate &value, std::string &payload)
+	{
+		if (value.rx.empty()) return frame_result::incomplete;
+		if (value.rx.front() != '$') return frame_result::invalid;
+		auto const marker = value.rx.find('#', 1);
+		if (marker == std::string::npos)
+			return value.rx.size() > auth_payload_limit + 1 ? frame_result::invalid : frame_result::incomplete;
+		if (marker - 1 > auth_payload_limit) return frame_result::invalid;
+		if (value.rx.size() < marker + 3) return frame_result::incomplete;
+		if (hex_digit(value.rx[marker + 1]) < 0 || hex_digit(value.rx[marker + 2]) < 0)
+			return frame_result::invalid;
+		std::uint8_t checksum = 0;
+		for (std::size_t index = 1; index < marker; ++index)
+		{
+			if (value.rx[index] == '}' || value.rx[index] == '$') return frame_result::invalid;
+			checksum += std::uint8_t(value.rx[index]);
+		}
+		auto const expected = (hex_digit(value.rx[marker + 1]) << 4) | hex_digit(value.rx[marker + 2]);
+		if (checksum != expected) return frame_result::invalid;
+		payload = value.rx.substr(1, marker - 1);
+		value.rx.erase(0, marker + 3);
+		return frame_result::complete;
+	}
