+		if (value >= 'A' && value <= 'F') return value - 'A' + 10;
+		return -1;
+	}
+
+	static bool hex_string(std::string_view value, std::size_t size)
+	{
+		return value.size() == size
+			&& std::all_of(value.begin(), value.end(), [] (char ch) { return hex_digit(ch) >= 0; });
+	}
