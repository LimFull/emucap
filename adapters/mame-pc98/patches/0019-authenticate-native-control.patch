+	bool write_candidate(candidate &value, std::size_t &work)
+	{
+		if (value.tx_offset >= value.tx.size()) return true;
+		auto const length = std::min({ chunk_limit, auth_work_limit - work, value.tx.size() - value.tx_offset });
+		if (!length) return true;
+		asio::error_code error;
+		auto const size = value.socket.write_some(asio::buffer(value.tx.data() + value.tx_offset, length), error);
+		if (idle(error)) return true;
+		if (error || !size) return false;
+		value.tx_offset += size;
+		work += size;
+		if (value.tx_offset == value.tx.size())
+		{
+			value.tx.clear();
+			value.tx_offset = 0;
+			value.stage = value.stage == auth_stage::server_reply ? auth_stage::server_ack : auth_stage::ok_ack;
+		}
+		return true;
+	}
+
+	bool read_candidate(candidate &value, std::size_t &work)
+	{
+		if (work >= auth_work_limit) return true;
+		std::array<char, chunk_limit> data;
+		asio::error_code error;
+		auto const length = std::min(chunk_limit, auth_work_limit - work);
+		auto const size = value.socket.read_some(asio::buffer(data.data(), length), error);
+		if (idle(error)) return true;
+		if (error || !size) return false;
+		value.rx.append(data.data(), size);
+		work += size;
+		return value.rx.size() <= (value.verified ? chunk_limit + auth_payload_limit + 8 : auth_payload_limit + 8);
+	}
+
+	bool advance(candidate &value)
+	{
+		for (unsigned transitions = 0; transitions < 4; ++transitions)
+		{
+			if (value.stage == auth_stage::server_reply || value.stage == auth_stage::ok_reply)
+				return true;
+			if (value.stage == auth_stage::server_ack || value.stage == auth_stage::ok_ack)
+			{
+				if (value.rx.empty()) return true;
+				if (value.rx.front() == '-')
+				{
+					value.rx.erase(0, 1);
+					if (++value.retries > 8) return false;
+					value.tx = value.reply;
+					value.tx_offset = 0;
+					value.stage = value.stage == auth_stage::server_ack ? auth_stage::server_reply : auth_stage::ok_reply;
+					return true;
+				}
+				if (value.rx.front() != '+') return false;
+				value.rx.erase(0, 1);
+				value.retries = 0;
+				if (value.stage == auth_stage::ok_ack)
+				{
+					value.stage = auth_stage::ready;
+					return true;
+				}
+				value.stage = auth_stage::client_proof;
+				continue;
+			}
+			std::string payload;
+			auto const parsed = take_frame(value, payload);
+			if (parsed == frame_result::incomplete) return true;
+			if (parsed == frame_result::invalid) return false;
+			if (value.stage == auth_stage::challenge)
+			{
+				static constexpr std::string_view prefix = "qEmucap,auth1:";
+				if (!payload.starts_with(prefix)) return false;
+				value.client_nonce = payload.substr(prefix.size());
+				if (!hex_string(value.client_nonce, 32)) return false;
+				if (m_nonce_counter == std::numeric_limits<std::uint64_t>::max()) return false;
+				auto const counter = std::to_string(++m_nonce_counter);
+				value.server_nonce = hmac_sha1(m_token, "nonce", value.client_nonce, counter).substr(0, 32);
+				auto const proof = hmac_sha1(m_token, "server", value.client_nonce, value.server_nonce);
+				queue_reply(value, frame("qEmucap,auth2:" + value.server_nonce + ":" + proof), auth_stage::server_reply);
+				return true;
+			}
+			static constexpr std::string_view prefix = "qEmucap,auth3:";
+			if (!payload.starts_with(prefix)) return false;
+			auto const proof = payload.substr(prefix.size());
+			if (!hex_string(proof, 40)) return false;
+			auto const expected = hmac_sha1(m_token, "client", value.client_nonce, value.server_nonce);
+			if (!constant_time_equal(expected, proof)) return false;
+			value.verified = true;
+			queue_reply(value, frame("OK"), auth_stage::ok_reply);
+			return true;
+		}
+		return false;
+	}
+
+	void promote(std::size_t index)
+	{
+		auto &winner = *m_candidates[index];
+		m_prefetched = std::move(winner.rx);
+		m_peer = std::move(winner.socket);
+		asio::error_code ignored;
+		m_listener.close(ignored);
+		for (std::size_t other = 0; other < m_candidates.size(); ++other)
+			if (other != index) m_candidates[other]->socket.close(ignored);
+		m_candidates.clear();
+		m_committed = true;
+	}
+
+	void service_candidates(std::size_t &work)
+	{
+		for (std::size_t index = 0; index < m_candidates.size() && work < auth_work_limit; )
+		{
+			auto &value = *m_candidates[index];
+			if (clock::now() >= value.deadline || !write_candidate(value, work)
+					|| !read_candidate(value, work) || !advance(value))
+			{
+				reject(index);
+				continue;
+			}
+			if (value.verified && value.stage == auth_stage::ready && value.tx.empty())
+			{
+				promote(index);
+				return;
+			}
+			++index;
+		}
+	}
