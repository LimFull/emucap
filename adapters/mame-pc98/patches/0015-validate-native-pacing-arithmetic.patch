+// Validate the narrowed native float before any float-to-integer conversion. The upper
+// duration bound comes from attotime's representation, not the public speed-request range.
+static attoseconds_t checked_throttle_period(double rate, osd_ticks_t frequency)
+{
+	if (!std::isfinite(rate) || rate <= 0 || rate >= ATTOTIME_MAX_SECONDS || !frequency)
+		return 0;
+	float const native_rate = float(rate);
+	if (!(native_rate > 0 && native_rate < ATTOTIME_MAX_SECONDS))
+		return 0;
+	double const period = double(ATTOSECONDS_PER_SECOND / frequency) * double(native_rate);
+	if (!(period >= 1.0 && period < double(std::numeric_limits<attoseconds_t>::max())))
+		return 0;
+	return attoseconds_t(period);
+}
+
+// attotime(0, attoseconds) does not normalize; construct a subsecond value or a checked
+// full duration. Never multiply ticks by period in an integer when the product can overflow.
+static bool throttle_elapsed(osd_ticks_t ticks, attoseconds_t period, attotime &elapsed)
+{
+	if (ticks <= osd_ticks_t((ATTOSECONDS_PER_SECOND - 1) / period))
+	{
+		elapsed = attotime(0, ticks * period);
+		return true;
+	}
+	double const seconds = double(ticks) * double(period) / double(ATTOSECONDS_PER_SECOND);
+	if (!(seconds >= 0 && seconds < ATTOTIME_MAX_SECONDS))
+		return false;
+	elapsed = attotime::from_double(seconds);
+	return true;
+}
+
+bool video_manager::is_valid_throttle_rate(double rate) const
+{
+	return checked_throttle_period(rate, osd_ticks_per_second()) != 0;
+}
