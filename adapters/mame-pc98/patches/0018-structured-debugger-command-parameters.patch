+// Execute one command with already-separated parameters. In particular, an
+// expression parameter cannot introduce a second command or an action argument.
+CMDERR debugger_console::execute_command_with_parameters(std::string_view command, const std::vector<std::string> &parameters)
+{
+	std::string first(command);
+	if (!parameters.empty())
+	{
+		first += ' ';
+		first += parameters.front();
+	}
+	std::vector<std::string_view> params{first};
+	for (size_t i = 1; i < parameters.size(); ++i)
+		params.emplace_back(parameters[i]);
+	const CMDERR result = internal_execute_command(true, params);
+	if (result.error_class() != CMDERR::NONE)
+		printf("%s\n", cmderr_to_string(result));
+	return result;
+}
