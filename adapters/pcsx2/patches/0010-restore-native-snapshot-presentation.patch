@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-3.0+
+#pragma once
+#include <cstdint>
+#include <vector>
+#include <utility>
+
+// Completed presentation loaded from the same archive as the guest state.
+// Owned by the GS thread; replaced by the next live frame or reset.
+class GSRestoredSnapshot
+{
+public:
+ void Clear() { m_pixels.clear(); m_width = m_height = 0; }
+ void Set(std::uint32_t width, std::uint32_t height, std::vector<std::uint32_t> pixels)
+ {
+  Clear();
+  if (!width || !height || static_cast<std::uint64_t>(width) * height != pixels.size()) return;
+  m_width = width; m_height = height; m_pixels = std::move(pixels);
+ }
+ bool Copy(std::uint32_t window_width, std::uint32_t window_height, bool apply_aspect, bool crop_borders,
+           std::uint32_t* width, std::uint32_t* height, std::vector<std::uint32_t>* pixels) const
+ {
+  if (window_width || window_height || !apply_aspect || crop_borders || m_pixels.empty()) return false;
+  *width = m_width; *height = m_height; *pixels = m_pixels;
+  return true;
+ }
+private:
+ std::uint32_t m_width = 0, m_height = 0;
+ std::vector<std::uint32_t> m_pixels;
+};
