+void MTGS::RestoreSnapshot(u32 width, u32 height, std::vector<u32> pixels)
+{
+	RunOnGSThread([width, height, pixels = std::move(pixels)]() mutable {
+		GSRestoreSnapshot(width, height, std::move(pixels));
+	});
+	WaitGS(false, false, false);
+}
