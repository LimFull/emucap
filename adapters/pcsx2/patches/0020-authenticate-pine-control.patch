+	PineServiceResult ServicePineCandidate(PineAuthCandidate& candidate, std::size_t& work,
+		std::uint64_t& nonce_counter)
+	{
+		if (std::chrono::steady_clock::now() >= candidate.deadline)
+			return PineServiceResult::Drop;
+		if (candidate.auth.Failed())
+			return PineServiceResult::Drop;
+		if (candidate.auth.Ready())
+			return PineServiceResult::Ready;
+		if (work == 0)
+			return PineServiceResult::Keep;
+
+		if (candidate.auth.PendingSize() != 0)
+		{
+			const std::size_t count = std::min({candidate.auth.PendingSize(), work, PineIoChunk});
+			const auto written = write_portable(candidate.socket, candidate.auth.PendingData(), count);
+			if (written > 0)
+			{
+				work -= static_cast<std::size_t>(written);
+				if (!candidate.auth.Wrote(static_cast<std::size_t>(written)))
+					return PineServiceResult::Drop;
+				return candidate.auth.Ready() ? PineServiceResult::Ready : PineServiceResult::Keep;
+			}
+			return PineSocketWouldBlock() ? PineServiceResult::Keep : PineServiceResult::Drop;
+		}
+
+		if (!candidate.auth.Advance(nonce_counter))
+			return PineServiceResult::Drop;
+		if (candidate.auth.PendingSize() != 0)
+			return PineServiceResult::Keep;
+		if (candidate.auth.Ready())
+			return PineServiceResult::Ready;
+
+		std::array<u8, PineIoChunk> buffer{};
+		const std::size_t count = std::min(work, buffer.size());
+		const auto received = read_portable(candidate.socket, buffer.data(), count);
+		if (received > 0)
