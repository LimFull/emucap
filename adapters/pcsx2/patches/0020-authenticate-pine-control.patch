+			}
+			return candidate.auth.Ready() ? PineServiceResult::Ready : PineServiceResult::Keep;
+		}
+		if (received == 0)
+			return PineServiceResult::Drop;
+		return PineSocketWouldBlock() ? PineServiceResult::Keep : PineServiceResult::Drop;
+	}
