+// SPDX-FileCopyrightText: 2026 EmuCap contributors
+// SPDX-License-Identifier: GPL-3.0+
+
+#pragma once
+
+#include "Sha256.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace EmuCap::PineAuth
+{
+	constexpr std::uint8_t ChallengeCommand = 0xA0;
+	constexpr std::uint8_t ProofCommand = 0xA1;
+	constexpr std::size_t NonceSize = 16;
+	constexpr std::size_t ProofSize = 32;
+	constexpr std::size_t PrefetchLimit = 650000;
+	constexpr std::size_t BufferLimit = 4 + 1 + ProofSize + PrefetchLimit;
+
+	using Nonce = std::array<std::uint8_t, NonceSize>;
+	using Proof = std::array<std::uint8_t, ProofSize>;
+
+	inline void HashField(CSha256& hash, const void* data, std::size_t size)
+	{
+		std::array<std::uint8_t, 8> length{};
+		std::uint64_t value = size;
+		for (int index = 7; index >= 0; --index)
+		{
+			length[static_cast<std::size_t>(index)] = static_cast<std::uint8_t>(value);
+			value >>= 8;
+		}
+		Sha256_Update(&hash, length.data(), length.size());
+		if (size != 0)
+			Sha256_Update(&hash, static_cast<const Byte*>(data), size);
+	}
+
+	inline Proof Hmac(std::string_view key, std::string_view direction,
+		const Nonce& client_nonce, const void* server_field, std::size_t server_field_size)
+	{
+		constexpr std::size_t block_size = 64;
+		std::array<std::uint8_t, block_size> key_block{};
+		if (key.size() > key_block.size())
+		{
+			CSha256 key_hash;
+			Sha256_Init(&key_hash);
+			Sha256_Update(&key_hash, reinterpret_cast<const Byte*>(key.data()), key.size());
+			Sha256_Final(&key_hash, key_block.data());
+		}
+		else
+		{
+			std::copy(key.begin(), key.end(), key_block.begin());
+		}
+
+		std::array<std::uint8_t, block_size> inner_pad{};
+		std::array<std::uint8_t, block_size> outer_pad{};
+		for (std::size_t index = 0; index < block_size; ++index)
+		{
+			inner_pad[index] = key_block[index] ^ 0x36;
+			outer_pad[index] = key_block[index] ^ 0x5c;
+		}
+
+		CSha256 inner;
+		Sha256_Init(&inner);
+		Sha256_Update(&inner, inner_pad.data(), inner_pad.size());
+		static constexpr std::string_view domain = "emucap-pcsx2-pine-auth-v1";
+		HashField(inner, domain.data(), domain.size());
+		HashField(inner, direction.data(), direction.size());
+		HashField(inner, client_nonce.data(), client_nonce.size());
+		HashField(inner, server_field, server_field_size);
+		Proof inner_digest{};
+		Sha256_Final(&inner, inner_digest.data());
+
+		CSha256 outer;
+		Sha256_Init(&outer);
+		Sha256_Update(&outer, outer_pad.data(), outer_pad.size());
+		Sha256_Update(&outer, inner_digest.data(), inner_digest.size());
+		Proof result{};
+		Sha256_Final(&outer, result.data());
+		return result;
+	}
+
+	inline Proof MakeProof(std::string_view key, std::string_view direction,
+		const Nonce& client_nonce, const Nonce& server_nonce)
+	{
+		return Hmac(key, direction, client_nonce, server_nonce.data(), server_nonce.size());
+	}
+
+	inline Nonce MakeServerNonce(std::string_view key, const Nonce& client_nonce, std::uint64_t counter)
+	{
+		std::array<std::uint8_t, 8> encoded{};
+		for (int index = 7; index >= 0; --index)
+		{
+			encoded[static_cast<std::size_t>(index)] = static_cast<std::uint8_t>(counter);
+			counter >>= 8;
+		}
+		const Proof digest = Hmac(key, "nonce", client_nonce, encoded.data(), encoded.size());
+		Nonce nonce{};
+		std::copy_n(digest.begin(), nonce.size(), nonce.begin());
+		return nonce;
+	}
+
+	inline bool ConstantTimeEqual(const std::uint8_t* left, const std::uint8_t* right, std::size_t size)
+	{
+		std::uint8_t difference = 0;
+		for (std::size_t index = 0; index < size; ++index)
+			difference |= left[index] ^ right[index];
+		return difference == 0;
+	}
+
+	inline std::uint32_t ReadU32(const std::uint8_t* data)
+	{
+		return static_cast<std::uint32_t>(data[0]) |
+			(static_cast<std::uint32_t>(data[1]) << 8) |
+			(static_cast<std::uint32_t>(data[2]) << 16) |
+			(static_cast<std::uint32_t>(data[3]) << 24);
+	}
+
+	inline void AppendU32(std::vector<std::uint8_t>& data, std::uint32_t value)
+	{
+		for (unsigned shift = 0; shift < 32; shift += 8)
+			data.push_back(static_cast<std::uint8_t>(value >> shift));
+	}
+
+	enum class ParseResult
+	{
+		Incomplete,
+		Invalid,
+		Complete,
+	};
+
+	inline ParseResult TakePacket(std::vector<std::uint8_t>& buffer, std::vector<std::uint8_t>& payload)
+	{
+		if (buffer.size() < 4)
+			return ParseResult::Incomplete;
+		const std::uint32_t size = ReadU32(buffer.data());
+		if (size < 5 || size > 4 + 1 + ProofSize)
+			return ParseResult::Invalid;
+		if (buffer.size() < size)
+			return ParseResult::Incomplete;
+		payload.assign(buffer.begin() + 4, buffer.begin() + size);
+		buffer.erase(buffer.begin(), buffer.begin() + size);
+		return ParseResult::Complete;
+	}
+
+	inline std::vector<std::uint8_t> Reply(const void* payload, std::size_t size)
+	{
+		std::vector<std::uint8_t> result;
+		result.reserve(5 + size);
+		AppendU32(result, static_cast<std::uint32_t>(5 + size));
+		result.push_back(0);
+		if (size != 0)
+		{
+			const auto* bytes = static_cast<const std::uint8_t*>(payload);
+			result.insert(result.end(), bytes, bytes + size);
+		}
+		return result;
+	}
+
+	class ServerSession
+	{
+	public:
+		explicit ServerSession(std::string_view token) : m_token(token) {}
+
+		bool Feed(const void* data, std::size_t size)
+		{
+			if (m_failed || m_rx.size() + size > BufferLimit)
+				return Fail();
+			if (size != 0)
+			{
+				const auto* bytes = static_cast<const std::uint8_t*>(data);
+				m_rx.insert(m_rx.end(), bytes, bytes + size);
+			}
+			return true;
+		}
+
+		bool Advance(std::uint64_t& nonce_counter)
+		{
+			if (m_failed || !m_tx.empty() || m_stage == Stage::Ready)
+				return !m_failed;
+			std::vector<std::uint8_t> packet;
+			const ParseResult parsed = TakePacket(m_rx, packet);
+			if (parsed == ParseResult::Incomplete)
+				return true;
+			if (parsed == ParseResult::Invalid)
+				return Fail();
+
+			if (m_stage == Stage::Challenge)
+			{
+				if (packet.size() != 1 + NonceSize || packet[0] != ChallengeCommand ||
+					nonce_counter == std::numeric_limits<std::uint64_t>::max())
+				{
+					return Fail();
+				}
+				std::copy_n(packet.begin() + 1, m_client_nonce.size(), m_client_nonce.begin());
+				m_server_nonce = MakeServerNonce(m_token, m_client_nonce, ++nonce_counter);
+				const Proof proof = MakeProof(m_token, "server", m_client_nonce, m_server_nonce);
+				std::array<std::uint8_t, NonceSize + ProofSize> reply{};
+				std::copy(m_server_nonce.begin(), m_server_nonce.end(), reply.begin());
+				std::copy(proof.begin(), proof.end(), reply.begin() + NonceSize);
+				m_tx = Reply(reply.data(), reply.size());
+				m_stage = Stage::ChallengeReply;
+				return true;
+			}
+
+			if (m_stage != Stage::ClientProof || packet.size() != 1 + ProofSize ||
+				packet[0] != ProofCommand)
+			{
+				return Fail();
+			}
+			const Proof expected = MakeProof(m_token, "client", m_client_nonce, m_server_nonce);
+			if (!ConstantTimeEqual(expected.data(), packet.data() + 1, expected.size()))
+				return Fail();
+			m_verified = true;
+			m_tx = Reply(nullptr, 0);
+			m_stage = Stage::SuccessReply;
+			return true;
+		}
+
+		const std::uint8_t* PendingData() const { return m_tx.data() + m_tx_offset; }
+		std::size_t PendingSize() const { return m_tx.size() - m_tx_offset; }
+
+		bool Wrote(std::size_t size)
+		{
+			if (size > PendingSize())
+				return Fail();
+			m_tx_offset += size;
+			if (m_tx_offset != m_tx.size())
+				return true;
+			m_tx.clear();
+			m_tx_offset = 0;
+			if (m_stage == Stage::ChallengeReply)
+				m_stage = Stage::ClientProof;
+			else if (m_stage == Stage::SuccessReply)
+				m_stage = Stage::Ready;
+			else
+				return Fail();
+			return true;
+		}
+
+		bool Verified() const { return m_verified; }
+		bool Ready() const { return m_stage == Stage::Ready && m_tx.empty(); }
+		bool Failed() const { return m_failed; }
+		std::vector<std::uint8_t> TakePrefetched() { return std::move(m_rx); }
+
+	private:
+		enum class Stage
+		{
+			Challenge,
+			ChallengeReply,
+			ClientProof,
+			SuccessReply,
+			Ready,
+		};
+
+		bool Fail()
+		{
+			m_failed = true;
+			return false;
+		}
+
+		std::string m_token;
+		Stage m_stage = Stage::Challenge;
+		std::vector<std::uint8_t> m_rx;
+		std::vector<std::uint8_t> m_tx;
+		std::size_t m_tx_offset = 0;
+		Nonce m_client_nonce{};
+		Nonce m_server_nonce{};
+		bool m_verified = false;
+		bool m_failed = false;
+	};
+} // namespace EmuCap::PineAuth
