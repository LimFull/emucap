+namespace
+{
+struct TextureStateBudget
+{
+  static constexpr u32 MaxEntries = 4096;
+  static constexpr u64 MaxBytes = u64{1} << 30;
+  static constexpr u64 MaxUploads = 65536;
+  static constexpr u32 MaxAssociations = 65536;
+  u64 serialized = 0;
+  u64 native = 0;
+  u64 uploads = 0;
+
+  bool Admit(const TextureConfig& config, u32 serialized_size)
+  {
+    const auto expected = config.GetSerializedSize(g_backend_info.MaxTextureSize);
+    if (!expected || *expected != serialized_size || serialized_size > MaxBytes - serialized)
+      return false;
+    const u64 subresources = u64{config.layers} * config.levels;
+    if (subresources > MaxUploads - uploads)
+      return false;
+    // A bounded representation estimate, not physical driver allocation size.
+    u64 layer_bytes = 0;
+    for (u32 level = 0; level < config.levels; ++level)
+    {
+      const u64 row = u64{std::max(config.width >> level, 1u)} * 8;
+      const u64 height = std::max(config.height >> level, 1u);
+      if (height > (MaxBytes - layer_bytes) / row)
+        return false;
+      layer_bytes += row * height;
+    }
+    // OpenGL cube storage allocates six faces even when fewer layers are serialized.
+    const u64 storage_layers = config.type == AbstractTextureType::Texture_CubeMap ?
+                                   std::max(u64{config.layers}, u64{6}) :
+                                   config.layers;
+    if (layer_bytes > MaxBytes / storage_layers)
+      return false;
+    const u64 native_bytes = std::max(layer_bytes * storage_layers, u64{65536});
+    if (native_bytes > MaxBytes - native)
+      return false;
+    serialized += serialized_size;
+    native += native_bytes;
+    uploads += subresources;
+    return true;
+  }
+};
+
+bool PreflightTextureState(PointerWrap& input, u64 last_entry_id, size_t bound_slots)
+{
+  const auto bytes = input.GetRemainingReadBytes();
+  if (!bytes)
+    return false;
+  u8* cursor = bytes->data();
+  PointerWrap p(&cursor, bytes->size(), PointerWrap::Mode::Read);
+  u32 entry_count = 0;
+  p.Do(entry_count);
+  if (p.HasError() || entry_count > TextureStateBudget::MaxEntries)
+    return false;
+
+  TextureStateBudget budget;
+  std::array<u64, TextureStateBudget::MaxEntries> logical_ids{};
+  for (u32 i = 0; i < entry_count; ++i)
+  {
+    TextureConfig config{};
+    p.Do(config);
+    u32 size = 0;
+    const u8* data = p.DoExternal(size);
+    if (p.HasError() || !data || !budget.Admit(config, size))
+      return false;
+    // Reuse the real field sequence without retaining a native texture or cache entry.
+    TCacheEntry metadata(nullptr, nullptr);
+    metadata.DoState(p);
+    if (p.HasError() || metadata.id >= last_entry_id)
+      return false;
+    logical_ids[i] = metadata.id;
+  }
+  std::sort(logical_ids.begin(), logical_ids.begin() + entry_count);
+  if (std::adjacent_find(logical_ids.begin(), logical_ids.begin() + entry_count) !=
+      logical_ids.begin() + entry_count)
+    return false;
+  p.DoMarker("TextureCacheEntries");
+  if (!p.IsReadMode() || p.HasError())
+    return false;
+
+  u32 remaining = TextureStateBudget::MaxAssociations;
+  for (unsigned list = 0; list < 4; ++list)
+  {
+    u32 count = 0;
+    p.Do(count);
+    if (p.HasError() || (list == 3 ? count > bound_slots : count > remaining))
+      return false;
+    if (list != 3)
+      remaining -= count;
+    for (u32 i = 0; i < count; ++i)
+    {
+      u32 first = 0, id = 0;
+      u64 hash = 0;
+      if (list == 2)
+        p.Do(hash);
+      else
+        p.Do(first);
+      p.Do(id);
+      if (p.HasError() || id >= entry_count || (list == 0 && first >= entry_count) ||
+          (list == 3 && first >= bound_slots))
+        return false;
+    }
+  }
+  return p.IsReadMode() && !p.HasError();
+}
