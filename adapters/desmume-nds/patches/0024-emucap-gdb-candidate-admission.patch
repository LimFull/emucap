diff --git a/desmume/src/gdbstub/EmucapGdbAdmission.h b/desmume/src/gdbstub/EmucapGdbAdmission.h
new file mode 100644
--- /dev/null
+++ b/desmume/src/gdbstub/EmucapGdbAdmission.h
@@ -0,0 +1,215 @@
+// Bounded native debugger candidates. Included after the gdbstub socket/auth helpers.
+#pragma once
+#include <array>
+
+static bool emucap_selectable_socket(SOCKET_TYPE sock) {
+#ifdef WIN32
+  return sock != INVALID_SOCKET;
+#else
+  return sock >= 0 && sock < FD_SETSIZE;
+#endif
+}
+
+static int emucap_set_nonblocking(SOCKET_TYPE sock, bool nonblocking) {
+#ifdef WIN32
+  u_long enabled = nonblocking ? 1 : 0;
+  return ioctlsocket(sock, FIONBIO, &enabled);
+#else
+  int flags = fcntl(sock, F_GETFL, 0);
+  if (flags < 0) return -1;
+  return fcntl(sock, F_SETFL, nonblocking ? flags | O_NONBLOCK : flags & ~O_NONBLOCK);
+#endif
+}
+
+class EmucapGdbCandidate {
+  enum Stage { Start, Payload, ChecksumHigh, ChecksumLow, ReplyAck };
+  // Prefix and hex-encoded token, excluding the RSP delimiters/checksum and terminator.
+  static const size_t PayloadLimit = sizeof("qEmucap,auth:") - 1 +
+                                     2 * EMUCAP_GDB_AUTH_MAX_TOKEN_BYTES;
+  static const size_t ReadsPerTurn = PayloadLimit + 4;
+  SOCKET_TYPE socket_ = (SOCKET_TYPE)-1;
+  Stage stage_ = Start;
+  uint8_t packet_[PayloadLimit + 1] = {};
+  size_t length_ = 0;
+  uint8_t checksum_ = 0, received_checksum_ = 0;
+  char output_[7] = {};
+  size_t output_size_ = 0, output_sent_ = 0;
+  int attempts_ = 0;
+  bool close_after_output_ = false;
+
+  void output(const char *bytes, size_t size, bool close_after) {
+    memcpy(output_, bytes, size);
+    output_size_ = size;
+    output_sent_ = 0;
+    close_after_output_ = close_after;
+  }
+
+  bool consume(uint8_t byte) {
+    switch (stage_) {
+    case Start:
+      if (byte != '$') { retire(); break; }
+      stage_ = Payload;
+      break;
+    case Payload:
+      if (byte == '#') {
+        packet_[length_] = 0;
+        stage_ = ChecksumHigh;
+      } else if (byte == 0 || length_ == PayloadLimit) {
+        retire();
+      } else {
+        packet_[length_++] = byte;
+        checksum_ += byte;
+      }
+      break;
+    case ChecksumHigh: {
+      int nibble = emucap_auth_hex_nibble(byte);
+      if (nibble < 0) { retire(); break; }
+      received_checksum_ = (uint8_t)(nibble << 4);
+      stage_ = ChecksumLow;
+      break;
+    }
+    case ChecksumLow: {
+      int nibble = emucap_auth_hex_nibble(byte);
+      if (nibble < 0) { retire(); break; }
+      received_checksum_ += (uint8_t)nibble;
+      if (received_checksum_ != checksum_)
+        output("-", 1, true);
+      else if (!emucap_auth_packet_matches(packet_))
+        output("+", 1, true);
+      else {
+        output("+$OK#9a", 7, false);
+        attempts_ = 1;
+        stage_ = ReplyAck;
+      }
+      break;
+    }
+    case ReplyAck:
+      if (byte == '+') return true;
+      if (attempts_ == EMUCAP_GDB_ACK_ATTEMPTS) retire();
+      else { ++attempts_; output("$OK#9a", 6, false); }
+      break;
+    }
+    return false;
+  }
+
+public:
+  emucap_gdb_clock::time_point deadline;
+  EmucapGdbCandidate() = default;
+  EmucapGdbCandidate(const EmucapGdbCandidate &) = delete;
+  EmucapGdbCandidate &operator=(const EmucapGdbCandidate &) = delete;
+  ~EmucapGdbCandidate() { retire(); }
+
+  SOCKET_TYPE socket() const { return socket_; }
+  bool token_verified() const {
+    return socket_ != (SOCKET_TYPE)-1 && stage_ == ReplyAck && !close_after_output_;
+  }
+  void retire() {
+    if (socket_ != (SOCKET_TYPE)-1) CLOSESOCKET(socket_);
+    socket_ = (SOCKET_TYPE)-1;
+  }
+  void start(SOCKET_TYPE socket) {
+    retire();
+    socket_ = socket;
+    deadline = emucap_gdb_clock::now() +
+        std::chrono::milliseconds(EMUCAP_GDB_AUTH_DEADLINE_MS);
+    stage_ = Start;
+    length_ = output_size_ = output_sent_ = 0;
+    checksum_ = received_checksum_ = 0;
+    attempts_ = 0;
+    close_after_output_ = false;
+    if (!emucap_selectable_socket(socket_) || emucap_set_nonblocking(socket_, true) != 0) {
+      retire(); return;
+    }
+    // NODELAY failure previously remained nonfatal; I/O setup must succeed at promotion.
+    set_socket_nodelay(socket_);
+  }
+  void select_sets(fd_set &reads, fd_set &writes) const {
+    if (output_sent_ < output_size_) FD_SET(socket_, &writes);
+    else FD_SET(socket_, &reads);
+  }
+  bool poll(const fd_set &reads, const fd_set &writes) {
+    if (emucap_gdb_clock::now() >= deadline) { retire(); return false; }
+    if (output_sent_ < output_size_) {
+      if (!FD_ISSET(socket_, &writes)) return false;
+      int n = emucap_socket_send(socket_, output_ + output_sent_,
+                                (int)(output_size_ - output_sent_));
+      if (n > 0) output_sent_ += (size_t)n;
+      else if (n == 0 || !emucap_socket_retryable()) retire();
+      if (socket_ != (SOCKET_TYPE)-1 && output_sent_ == output_size_ && close_after_output_)
+        retire();
+      return false;
+    }
+    if (!FD_ISSET(socket_, &reads)) return false;
+    // Bound syscalls as well as payload. Reading through the maximum available frame
+    // in one turn prevents a finite accept burst from evicting large valid auth packets.
+    for (size_t i = 0; i < ReadsPerTurn; ++i) {
+      uint8_t byte;
+      int n = recv(socket_, (char *)&byte, 1, 0);
+      if (n == 1) {
+        if (consume(byte)) return emucap_gdb_clock::now() < deadline;
+        if (socket_ == (SOCKET_TYPE)-1 || output_sent_ < output_size_) return false;
+      } else {
+        if (n == 0 || !emucap_socket_retryable()) retire();
+        return false;
+      }
+    }
+    return false;
+  }
+  SOCKET_TYPE promote() {
+    if (emucap_gdb_clock::now() >= deadline ||
+        emucap_set_nonblocking(socket_, false) != 0 ||
+        emucap_set_socket_io_timeout(socket_) != 0) {
+      retire(); return (SOCKET_TYPE)-1;
+    }
+    SOCKET_TYPE socket = socket_;
+    socket_ = (SOCKET_TYPE)-1;
+    return socket;
+  }
+};
+
+class EmucapGdbAdmission {
+  // Winsock fd_sets also hold listener/control/established sockets; eight fits its
+  // default64 entries. POSIX additionally validates each descriptor's numeric range.
+  std::array<EmucapGdbCandidate, 8> candidates_;
+public:
+  void clear() { for (auto &candidate : candidates_) candidate.retire(); }
+  void add(SOCKET_TYPE socket) {
+    if (!emucap_selectable_socket(socket)) { CLOSESOCKET(socket); return; }
+    EmucapGdbCandidate *oldest = nullptr;
+    auto now = emucap_gdb_clock::now();
+    for (auto &candidate : candidates_) {
+      if (candidate.socket() == (SOCKET_TYPE)-1) { candidate.start(socket); return; }
+      if (now >= candidate.deadline) { candidate.start(socket); return; }
+      if (!candidate.token_verified() &&
+          (oldest == nullptr || candidate.deadline < oldest->deadline))
+        oldest = &candidate;
+    }
+    if (oldest != nullptr) oldest->start(socket);
+    else CLOSESOCKET(socket);
+  }
+  bool select_sets(fd_set &reads, fd_set &writes, timeval &timeout) {
+    bool pending = false;
+    auto now = emucap_gdb_clock::now();
+    auto nearest = now + std::chrono::milliseconds(EMUCAP_GDB_AUTH_DEADLINE_MS);
+    for (auto &candidate : candidates_) {
+      if (candidate.socket() == (SOCKET_TYPE)-1) continue;
+      if (now >= candidate.deadline) { candidate.retire(); continue; }
+      pending = true;
+      if (candidate.deadline < nearest) nearest = candidate.deadline;
+      candidate.select_sets(reads, writes);
+    }
+    auto remaining = std::chrono::duration_cast<std::chrono::microseconds>(nearest - now);
+    timeout.tv_sec = (long)(remaining.count() / 1000000);
+    timeout.tv_usec = (long)(remaining.count() % 1000000);
+    return pending;
+  }
+  SOCKET_TYPE service(const fd_set &reads, const fd_set &writes) {
+    for (auto &candidate : candidates_) {
+      if (candidate.socket() != (SOCKET_TYPE)-1 && candidate.poll(reads, writes)) {
+        SOCKET_TYPE socket = candidate.promote();
+        if (socket != (SOCKET_TYPE)-1) { clear(); return socket; }
+      }
+    }
+    return (SOCKET_TYPE)-1;
+  }
+};
