+/* Installed before execution. Called only by the emulation thread after a
+ * safe state job, independently of the asynchronous persistence worker. */
+static void (*emucap_state_boundary_callback)(void);
+EXPORT m64p_error CALL CoreEmucapSetStateBoundaryCallback(unsigned int version, void (*callback)(void))
+{
+    if (version != 1) return M64ERR_INPUT_INVALID;
+    emucap_state_boundary_callback = callback;
+    return M64ERR_SUCCESS;
+}
+void savestates_emucap_boundary(void)
+{
+    if (emucap_state_boundary_callback) emucap_state_boundary_callback();
+}
