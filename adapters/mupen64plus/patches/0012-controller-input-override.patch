+/* One native owner publishes enable and the complete controller word together.
+ * No plugin call or guest work occurs under this short lock. Host state is not
+ * part of savestates; the library is unloaded only after the guest has stopped. */
+static SDL_SpinLock emucap_input_lock;
+static uint32_t emucap_input_word;
+static uint32_t emucap_input_enabled;
+
+EXPORT m64p_error CALL CoreEmucapInput(uint32_t version, uint32_t port,
+    uint32_t enabled, uint32_t buttons, int32_t x, int32_t y)
+{
+    if (version != 1 || port != 0 || enabled > 1 || buttons > 0x3fff ||
+        x < -128 || x > 127 || y < -128 || y > 127)
+        return M64ERR_INPUT_INVALID;
+    SDL_AtomicLock(&emucap_input_lock);
+    emucap_input_word = buttons | ((uint32_t)(uint8_t)x << 16)
+        | ((uint32_t)(uint8_t)y << 24);
+    emucap_input_enabled = enabled;
+    SDL_AtomicUnlock(&emucap_input_lock);
+    return M64ERR_SUCCESS;
+}
+
+static void emucap_controller_input(int port, uint32_t* word)
+{
+    if (port != 0) return;
+    SDL_AtomicLock(&emucap_input_lock);
+    if (emucap_input_enabled) *word = emucap_input_word;
+    SDL_AtomicUnlock(&emucap_input_lock);
+}
 
