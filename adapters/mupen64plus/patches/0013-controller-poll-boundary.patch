+/* Registered before execution; retired after the execution thread has stopped. */
+static void (*emucap_poll_callback)(uint32_t);
+EXPORT m64p_error CALL CoreEmucapSetPollCallback(uint32_t version, void (*callback)(uint32_t))
+{
+    if (version != 1) return M64ERR_INPUT_INVALID;
+    emucap_poll_callback = callback;
+    return M64ERR_SUCCESS;
+}
+void emucap_controller_response(void* opaque, const struct controller_input_backend_interface* backend,
+    uint32_t word)
+{
+    if (backend != &g_icontroller_input_backend_plugin_compat) return;
+    const struct controller_input_compat* controller = opaque;
+    if (controller->control_id == 0 && emucap_poll_callback) emucap_poll_callback(word);
+}
